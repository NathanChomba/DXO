<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DXO.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DXO.UI.ViewModels"
    Title="DXO">

    <Grid x:Name="Root" Background="{StaticResource DxoWindowBackground}" KeyDown="Root_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Custom title bar ===== -->
        <Grid x:Name="AppTitleBar" Padding="14,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- DXO wordmark (Assets\dxo-logo.png, white line art) -->
                <Image x:Name="TitleLogo" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Text="v0.1" Style="{StaticResource DxoCaption}" VerticalAlignment="Center" />
            </StackPanel>

        </Grid>

        <!-- ===== Controller bar: one pill per connected controller ===== -->
        <Grid Grid.Row="1" Padding="14,2,14,10" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Scrolls sideways when the pills don't fit (mouse wheel works too) -->
            <ScrollViewer x:Name="PadScroll" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                          PointerWheelChanged="PadScroll_PointerWheelChanged" Padding="0,0,0,4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ItemsControl x:Name="PadBar" ItemsSource="{x:Bind Device.Pads, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PadViewModel">
                            <Button Click="Pill_Click" Padding="12,0" Height="32" CornerRadius="16"
                                    Background="{StaticResource DxoSurfaceLow}" BorderThickness="1"
                                    BorderBrush="{StaticResource DxoStroke}"
                                    ToolTipService.ToolTip="{x:Bind PlayerText, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind Name, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                             Fill="{StaticResource DxoSuccess}" />
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                                    <TextBlock Text="|" Foreground="{StaticResource DxoStroke}" VerticalAlignment="Center" />
                                    <FontIcon Glyph="{x:Bind TransportGlyph, Mode=OneWay}" FontSize="12" Foreground="{StaticResource DxoTextSecondary}" />
                                    <TextBlock Text="{x:Bind RateText, Mode=OneWay}" Style="{StaticResource DxoMono}" FontSize="12"
                                               Foreground="{StaticResource DxoSecondary}" VerticalAlignment="Center" />
                                    <Grid Width="22" Height="12" VerticalAlignment="Center">
                                        <Border Width="19" HorizontalAlignment="Left" BorderThickness="1.5" CornerRadius="2.5"
                                                BorderBrush="{StaticResource DxoTextMuted}" />
                                        <Rectangle Width="{x:Bind BatteryFill, Mode=OneWay}" Height="6" RadiusX="1" RadiusY="1"
                                                   Margin="3,0,0,0" HorizontalAlignment="Left" Fill="{StaticResource DxoSuccess}" />
                                        <Rectangle Width="2" Height="4" HorizontalAlignment="Right" Fill="{StaticResource DxoTextMuted}" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind BatteryText, Mode=OneWay}" Style="{StaticResource DxoMono}" FontSize="12" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind HiddenVisibility, Mode=OneWay}">
                                        <FontIcon Glyph="&#xEA18;" FontSize="12" Foreground="{StaticResource DxoAccentLight}" />
                                        <TextBlock Text="HIDDEN" Style="{StaticResource DxoMono}" FontSize="10"
                                                   Foreground="{StaticResource DxoAccentLight}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Padding="8,2" CornerRadius="10" Background="{StaticResource DxoAccentSoft}" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Profile, Mode=OneWay}" FontSize="12" Foreground="{StaticResource DxoAccentLight}" />
                                    </Border>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Click="Pair_Click" Padding="12,0" Height="32" CornerRadius="16" Background="Transparent"
                        BorderBrush="{StaticResource DxoStroke}" BorderThickness="1"
                        ToolTipService.ToolTip="Open Windows Bluetooth settings to pair a controller">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="{StaticResource DxoTextMuted}" />
                        <TextBlock Text="Pair a controller" FontSize="12" Foreground="{StaticResource DxoTextMuted}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            </ScrollViewer>
            <InfoBar Grid.Column="1" VerticalAlignment="Center" Padding="0" MinHeight="32"
                     IsClosable="False" Severity="Warning"
                     IsOpen="{x:Bind Device.HasStatus, Mode=OneWay}"
                     Message="{x:Bind Device.Status, Mode=OneWay}" />
        </Grid>

        <!-- ===== Nav + content ===== -->
        <NavigationView x:Name="Nav" Grid.Row="2"
                        PaneDisplayMode="Left"
                        OpenPaneLength="220"
                        CompactModeThresholdWidth="0"
                        ExpandedModeThresholdWidth="1000"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        IsPaneToggleButtonVisible="True"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="My Controller" Tag="controller">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7FC;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Profiles" Tag="profiles">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE77B;" /></NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator />
                <NavigationViewItemHeader Content="Configure" />
                <NavigationViewItem Content="Mappings" Tag="mappings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8AB;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Virtual Device" Tag="virtual">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Adaptive Triggers" Tag="triggers">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE945;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Lighting" Tag="lighting">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE790;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Haptics and Rumble" Tag="haptics">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE995;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Motion" Tag="motion">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7AD;" /></NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator />
                <NavigationViewItem Content="Games" Tag="games">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Diagnostics" Tag="diagnostics">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="About" Tag="about">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- ===== Controller card: grows out of the pill you click ===== -->
        <Grid x:Name="IslandLayer" Grid.RowSpan="3" Visibility="Collapsed">
            <Border x:Name="IslandScrim" Background="#59080810" Opacity="0" Tapped="Scrim_Tapped" />
            <Canvas>
                <!-- Always full size; a rounded clip grows from the pill's shape to reveal it (no stretched text) -->
                <Border x:Name="Island" Width="440" Height="424" CornerRadius="16" Padding="14,0,14,14"
                        Background="{StaticResource DxoSurfaceLow}" BorderBrush="{StaticResource DxoStroke}" BorderThickness="1">
                    <Grid x:Name="IslandContent" Opacity="0" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- header: same spot as the pill's text, so the pill seems to open -->
                        <Grid ColumnSpacing="9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="7" Height="7" Fill="{StaticResource DxoSuccess}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock x:Name="CardName" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock x:Name="CardPlayer" Style="{StaticResource DxoCaption}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="CardBattery" Grid.Column="2" Style="{StaticResource DxoMono}" FontSize="12" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Border Background="#131318" CornerRadius="10" Padding="10,8">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="LINK" FontSize="10" Foreground="{StaticResource DxoTextMuted}" CharacterSpacing="60" />
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon x:Name="CardLinkIcon" FontSize="12" />
                                        <TextBlock x:Name="CardLink" FontSize="13" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#131318" CornerRadius="10" Padding="10,8">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="REPORT RATE" FontSize="10" Foreground="{StaticResource DxoTextMuted}" CharacterSpacing="60" />
                                    <TextBlock x:Name="CardRate" Style="{StaticResource DxoMono}" Foreground="{StaticResource DxoSecondary}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#131318" CornerRadius="10" Padding="10,8">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="GAMES SEE" FontSize="10" Foreground="{StaticResource DxoTextMuted}" CharacterSpacing="60" />
                                    <TextBlock x:Name="CardTarget" FontSize="13" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- This controller's own settings (saved per controller, kept across profiles) -->
                        <Grid Grid.Row="2" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Name" Foreground="{StaticResource DxoTextSecondary}" VerticalAlignment="Center" />
                            <TextBox x:Name="CardNameBox" Grid.Column="1" Width="220" MaxLength="40"
                                     KeyDown="CardNameBox_KeyDown" LostFocus="CardNameBox_LostFocus"
                                     AutomationProperties.Name="Controller name" />
                        </Grid>
                        <Grid Grid.Row="3" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Emulate as" Foreground="{StaticResource DxoTextSecondary}" VerticalAlignment="Center" />
                            <ComboBox x:Name="CardTargetBox" Grid.Column="1" Width="220" SelectionChanged="CardTarget_SelectionChanged"
                                      AutomationProperties.Name="Emulate as">
                                <x:String>Xbox 360 controller</x:String>
                                <x:String>DualShock 4</x:String>
                                <x:String>Nothing (native)</x:String>
                            </ComboBox>
                        </Grid>

                        <Grid Grid.Row="4" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEA18;" FontSize="14" Foreground="{StaticResource DxoAccentLight}" />
                                <TextBlock Text="Hide real controller from games" Foreground="{StaticResource DxoAccentLight}" VerticalAlignment="Center" />
                            </StackPanel>
                            <ToggleSwitch x:Name="CardHide" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                          Toggled="CardHide_Toggled" AutomationProperties.Name="Hide real controller from games" />
                        </Grid>

                        <Grid Grid.Row="5" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Default profile" Foreground="{StaticResource DxoTextSecondary}" VerticalAlignment="Center"
                                       ToolTipService.ToolTip="Used outside games, and in games with no profile of their own" />
                            <ComboBox x:Name="CardProfile" Grid.Column="1" Width="220" SelectionChanged="CardProfile_SelectionChanged"
                                      AutomationProperties.Name="Profile" />
                        </Grid>

                        <Grid Grid.Row="7" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition /><ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CardReconnect" HorizontalAlignment="Stretch" Height="34" Click="CardReconnect_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                    <TextBlock x:Name="CardReconnectText" Text="Reconnect" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" HorizontalAlignment="Stretch" Height="34" Style="{StaticResource AccentButtonStyle}" Click="CardOpen_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                                    <TextBlock Text="Open My Controller" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Canvas>
        </Grid>
    </Grid>
</Window>
