<?xml version="1.0" encoding="utf-8"?>
<!-- DXO visual tokens, following the Stitch "WinUI Fluent HID Driver" design system:
     neutral near-black surfaces, violet primary, cyan secondary, pink tertiary.
     Change DxoAccentColor to re-skin the app. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Colours ===== -->
    <Color x:Key="DxoAccentColor">#A078FF</Color>          <!-- primary-container -->
    <Color x:Key="DxoAccentLightColor">#D0BCFF</Color>     <!-- primary -->
    <Color x:Key="DxoAccentSoftColor">#33A078FF</Color>
    <Color x:Key="DxoSecondaryColor">#4CD7F6</Color>       <!-- cyan: live values, links -->
    <Color x:Key="DxoTertiaryColor">#FFB0CD</Color>        <!-- pink: highlights -->
    <Color x:Key="DxoWindowTopColor">#17161D</Color>
    <Color x:Key="DxoWindowBottomColor">#131318</Color>
    <Color x:Key="DxoNavColor">#131318</Color>
    <Color x:Key="DxoSurfaceColor">#1F1F24</Color>         <!-- surface-container -->
    <Color x:Key="DxoSurfaceRaisedColor">#2A292F</Color>   <!-- surface-container-high -->
    <Color x:Key="DxoSurfaceLowColor">#1B1B20</Color>      <!-- surface-container-low -->
    <Color x:Key="DxoStrokeColor">#26FFFFFF</Color>
    <Color x:Key="DxoTextColor">#E4E1E9</Color>
    <Color x:Key="DxoTextSecondaryColor">#CBC3D7</Color>   <!-- on-surface-variant -->
    <Color x:Key="DxoTextMutedColor">#958EA0</Color>       <!-- outline -->
    <Color x:Key="DxoSuccessColor">#3DDC84</Color>
    <Color x:Key="DxoWarningColor">#F2B544</Color>
    <Color x:Key="DxoDangerColor">#FF5A6E</Color>

    <!-- ===== Brushes ===== -->
    <SolidColorBrush x:Key="DxoAccent" Color="{StaticResource DxoAccentColor}" />
    <SolidColorBrush x:Key="DxoAccentSoft" Color="{StaticResource DxoAccentSoftColor}" />
    <SolidColorBrush x:Key="DxoAccentLight" Color="{StaticResource DxoAccentLightColor}" />
    <SolidColorBrush x:Key="DxoSecondary" Color="{StaticResource DxoSecondaryColor}" />
    <SolidColorBrush x:Key="DxoTertiary" Color="{StaticResource DxoTertiaryColor}" />
    <SolidColorBrush x:Key="DxoSurfaceLow" Color="{StaticResource DxoSurfaceLowColor}" />
    <SolidColorBrush x:Key="DxoTextMuted" Color="{StaticResource DxoTextMutedColor}" />
    <SolidColorBrush x:Key="DxoNav" Color="{StaticResource DxoNavColor}" />
    <SolidColorBrush x:Key="DxoSurface" Color="{StaticResource DxoSurfaceColor}" />
    <SolidColorBrush x:Key="DxoSurfaceRaised" Color="{StaticResource DxoSurfaceRaisedColor}" />
    <SolidColorBrush x:Key="DxoStroke" Color="{StaticResource DxoStrokeColor}" />
    <SolidColorBrush x:Key="DxoTextSecondary" Color="{StaticResource DxoTextSecondaryColor}" />
    <SolidColorBrush x:Key="DxoSuccess" Color="{StaticResource DxoSuccessColor}" />
    <SolidColorBrush x:Key="DxoWarning" Color="{StaticResource DxoWarningColor}" />
    <SolidColorBrush x:Key="DxoDanger" Color="{StaticResource DxoDangerColor}" />

    <LinearGradientBrush x:Key="DxoWindowBackground" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Color="{StaticResource DxoWindowTopColor}" Offset="0" />
        <GradientStop Color="{StaticResource DxoWindowBottomColor}" Offset="1" />
    </LinearGradientBrush>

    <!-- DXO's own hero art: abstract accent glow, no photos -->
    <LinearGradientBrush x:Key="DxoHeroBackground" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#1B1B20" Offset="0" />
        <GradientStop Color="#2A1F4A" Offset="0.6" />
        <GradientStop Color="#5516BE" Offset="1" />
    </LinearGradientBrush>

    <!-- Point WinUI's own accent at ours so toggles, sliders, radio buttons,
         the nav selection bar and accent buttons all pick it up. -->
    <Color x:Key="SystemAccentColor">#A078FF</Color>
    <Color x:Key="SystemAccentColorLight1">#B898FF</Color>
    <Color x:Key="SystemAccentColorLight2">#D0BCFF</Color>
    <Color x:Key="SystemAccentColorLight3">#E9DDFF</Color>
    <Color x:Key="SystemAccentColorDark1">#8A5CF0</Color>
    <Color x:Key="SystemAccentColorDark2">#6D3BD7</Color>
    <Color x:Key="SystemAccentColorDark3">#5516BE</Color>

    <!-- Cards blend into the plum background instead of default grey -->
    <SolidColorBrush x:Key="SettingsCardBackground" Color="{StaticResource DxoSurfaceColor}" />
    <SolidColorBrush x:Key="SettingsCardBackgroundPointerOver" Color="{StaticResource DxoSurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="{StaticResource DxoStrokeColor}" />
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />

    <!-- ===== Shapes and spacing ===== -->
    <CornerRadius x:Key="DxoCardRadius">12</CornerRadius>
    <CornerRadius x:Key="DxoRowRadius">8</CornerRadius>
    <Thickness x:Key="DxoPagePadding">24,16,24,24</Thickness>
    <x:Double x:Key="DxoRowSpacing">4</x:Double>

    <!-- ===== Styles ===== -->
    <Style x:Key="DxoCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DxoSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource DxoStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource DxoCardRadius}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Quick-action tile on Home: card-looking button -->
    <Style x:Key="DxoTile" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DxoSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource DxoStroke}" />
        <Setter Property="CornerRadius" Value="{StaticResource DxoCardRadius}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,8,8" />
    </Style>

    <Style x:Key="DxoPageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <Style x:Key="DxoSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,16,0,6" />
    </Style>

    <Style x:Key="DxoCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource DxoTextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DxoValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Telemetry numbers: monospace, like the Stitch "telemetry-value" type -->
    <Style x:Key="DxoMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Small status pill (title bar, badges) -->
    <Style x:Key="DxoPill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DxoSurfaceLow}" />
        <Setter Property="BorderBrush" Value="{StaticResource DxoStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="12,4" />
    </Style>
</ResourceDictionary>
