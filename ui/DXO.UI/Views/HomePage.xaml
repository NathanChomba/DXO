<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DXO.UI.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="{StaticResource DxoPagePadding}" Spacing="16">

            <!-- ===== Hero: DXO's own abstract art, no photos ===== -->
            <Grid Height="220" CornerRadius="{StaticResource DxoCardRadius}"
                  Background="{StaticResource DxoHeroBackground}"
                  BorderBrush="{StaticResource DxoAccent}" BorderThickness="1">
                <!-- concentric rings, a nod to a thumbstick seen from above -->
                <Canvas HorizontalAlignment="Right" Width="420" Height="220" Opacity="0.55">
                    <Ellipse Canvas.Left="150" Canvas.Top="-60" Width="340" Height="340" Stroke="{StaticResource DxoAccent}" StrokeThickness="1" />
                    <Ellipse Canvas.Left="200" Canvas.Top="-10" Width="240" Height="240" Stroke="{StaticResource DxoAccent}" StrokeThickness="2" />
                    <Ellipse Canvas.Left="250" Canvas.Top="40" Width="140" Height="140" Stroke="{StaticResource DxoAccent}" StrokeThickness="3" />
                    <Ellipse Canvas.Left="295" Canvas.Top="85" Width="50" Height="50" Fill="{StaticResource DxoAccent}" Opacity="0.6" />
                </Canvas>
                <StackPanel VerticalAlignment="Bottom" Margin="28,0,0,24" Spacing="4">
                    <TextBlock Text="DXO" FontSize="40" FontWeight="Bold" />
                    <TextBlock Text="Your controller, your rules." FontSize="16" />
                    <TextBlock Text="Remapping · Adaptive triggers · Lighting · Motion" Style="{StaticResource DxoCaption}" />
                </StackPanel>
            </Grid>

            <!-- ===== Quick actions ===== -->
            <TextBlock Text="Quick actions" Style="{StaticResource DxoSectionTitle}" />
            <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="280" ItemHeight="76">
                <Button Tag="controller" Click="Tile_Click" Style="{StaticResource DxoTile}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE7FC;" />
                        <StackPanel><TextBlock Text="My Controller" FontWeight="SemiBold" /><TextBlock Text="Battery, connection, live input" Style="{StaticResource DxoCaption}" /></StackPanel>
                    </StackPanel>
                </Button>
                <Button Tag="profiles" Click="Tile_Click" Style="{StaticResource DxoTile}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE77B;" />
                        <StackPanel><TextBlock Text="Profiles" FontWeight="SemiBold" /><TextBlock Text="Create, load and switch profiles" Style="{StaticResource DxoCaption}" /></StackPanel>
                    </StackPanel>
                </Button>
                <Button Tag="virtual" Click="Tile_Click" Style="{StaticResource DxoTile}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE7F4;" />
                        <StackPanel><TextBlock Text="Virtual Device" FontWeight="SemiBold" /><TextBlock Text="What games see" Style="{StaticResource DxoCaption}" /></StackPanel>
                    </StackPanel>
                </Button>
                <Button Tag="lighting" Click="Tile_Click" Style="{StaticResource DxoTile}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE790;" />
                        <StackPanel><TextBlock Text="Lighting" FontWeight="SemiBold" /><TextBlock Text="Light bar colour and player LEDs" Style="{StaticResource DxoCaption}" /></StackPanel>
                    </StackPanel>
                </Button>
                <Button Tag="triggers" Click="Tile_Click" Style="{StaticResource DxoTile}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE945;" />
                        <StackPanel><TextBlock Text="Adaptive Triggers" FontWeight="SemiBold" /><TextBlock Text="Resistance and click effects" Style="{StaticResource DxoCaption}" /></StackPanel>
                    </StackPanel>
                </Button>
                <Button Tag="settings" Click="Tile_Click" Style="{StaticResource DxoTile}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE713;" />
                        <StackPanel><TextBlock Text="Settings" FontWeight="SemiBold" /><TextBlock Text="Drivers, startup, safety" Style="{StaticResource DxoCaption}" /></StackPanel>
                    </StackPanel>
                </Button>
            </VariableSizedWrapGrid>

            <!-- ===== What's new ===== -->
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Background="{StaticResource DxoSurface}" Header="What's new in DXO v0.1">
                <StackPanel Spacing="4">
                    <TextBlock Text="• Reads DualSense, DualSense Edge and DualShock 4 over USB and Bluetooth" />
                    <TextBlock Text="• Virtual Xbox 360 controller with the real pad hidden from games" />
                    <TextBlock Text="• Lightbar, rumble and adaptive-trigger control" />
                    <TextBlock Text="• Profiles that switch automatically per game" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
