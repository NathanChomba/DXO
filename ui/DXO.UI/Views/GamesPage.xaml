<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DXO.UI.Views.GamesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="{StaticResource DxoPagePadding}" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Games" Style="{StaticResource DxoPageTitle}" />
            <TextBlock Style="{StaticResource DxoCaption}"
                       Text="Give a game its own profile and DXO switches to it whenever that game is in front. Games without one use whatever profile is active." />
        </StackPanel>

        <!-- toolbar -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search games" QueryIcon="Find" TextChanged="Search_TextChanged" MaxWidth="360" HorizontalAlignment="Left" Width="360" />
            <Button Grid.Column="1" Click="Rescan_Click">
                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock Text="Scan again" /></StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock Text="Add a game" /></StackPanel>
                <Button.Flyout>
                    <Flyout x:Name="AddFlyout" Opening="AddFlyout_Opening">
                        <StackPanel Spacing="10" Width="320">
                            <TextBlock Text="Pick a game that's running now" Style="{StaticResource DxoCaption}" />
                            <ComboBox x:Name="RunningBox" HorizontalAlignment="Stretch" PlaceholderText="Start the game, then pick it here" />
                            <TextBlock Text="or type its .exe name" Style="{StaticResource DxoCaption}" />
                            <TextBox x:Name="ExeBox" PlaceholderText="eldenring.exe" />
                            <Button Content="Add" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Click="Add_Click" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- list -->
        <Border Grid.Row="2" Style="{StaticResource DxoCard}" Padding="4">
            <Grid>
                <ListView x:Name="GameList" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,10" ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="240" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource DxoCaption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Click="EachController_Click" Visibility="{Binding EachVisibility}"
                                        ToolTipService.ToolTip="Give a controller its own profile for this game">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding EachLabel}" FontSize="12" />
                                        <FontIcon Glyph="{Binding EachGlyph}" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                          ItemsSource="{Binding Choices}" SelectedIndex="{Binding Assigned}"
                                          SelectionChanged="Assign_SelectionChanged"
                                          ToolTipService.ToolTip="Profile for all controllers in this game" />

                                <!-- one line per connected controller -->
                                <ItemsControl Grid.Row="1" Grid.ColumnSpan="3" ItemsSource="{Binding Overrides}"
                                              Visibility="{Binding OverridesVisibility}" Margin="16,0,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="12" Padding="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="240" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE7FC;" FontSize="13" Foreground="{StaticResource DxoTextSecondary}" />
                                                    <TextBlock Text="{Binding PadName}" />
                                                    <TextBlock Text="{Binding PlayerText}" Style="{StaticResource DxoCaption}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Choices}"
                                                          SelectedIndex="{Binding Assigned}" SelectionChanged="Override_SelectionChanged" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                    <ProgressRing x:Name="ScanRing" IsActive="False" Width="28" Height="28" />
                    <TextBlock x:Name="EmptyText" Style="{StaticResource DxoCaption}" HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="3" Style="{StaticResource DxoCaption}" />
    </Grid>
</Page>
