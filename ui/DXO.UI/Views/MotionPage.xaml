<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DXO.UI.Views.MotionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <Grid Padding="{StaticResource DxoPagePadding}" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Motion" Style="{StaticResource DxoPageTitle}" />
            <TextBlock Text="Aim by turning the controller, and send motion to emulators. Changes apply straight away; Save keeps them in the profile."
                       Style="{StaticResource DxoCaption}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <Grid ColumnSpacing="16" Padding="0,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320" />
                    <ColumnDefinition Width="*" MinWidth="340" />
                </Grid.ColumnDefinitions>

                <!-- ===== Left: live readings + calibration ===== -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Live motion" Style="{StaticResource DxoSectionTitle}" Margin="0,0,0,6" />
                    <Border Style="{StaticResource DxoCard}">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- turn speed bars, centred at zero -->
                            <StackPanel Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="Turn speed" Style="{StaticResource DxoCaption}" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="20" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Pitch" VerticalAlignment="Center" />
                                    <Grid x:Name="PitchTrack" Grid.Column="1" Height="8" CornerRadius="4" Background="{StaticResource DxoSurfaceRaised}">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Rectangle x:Name="PitchNeg" HorizontalAlignment="Right" Width="0" Fill="{StaticResource DxoAccent}" />
                                        <Rectangle x:Name="PitchPos" Grid.Column="1" HorizontalAlignment="Left" Width="0" Fill="{StaticResource DxoAccent}" />
                                    </Grid>
                                    <TextBlock x:Name="PitchText" Grid.Column="2" Style="{StaticResource DxoCaption}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                    <TextBlock Grid.Row="1" Text="Yaw" VerticalAlignment="Center" />
                                    <Grid Grid.Row="1" Grid.Column="1" Height="8" CornerRadius="4" Background="{StaticResource DxoSurfaceRaised}">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Rectangle x:Name="YawNeg" HorizontalAlignment="Right" Width="0" Fill="{StaticResource DxoAccent}" />
                                        <Rectangle x:Name="YawPos" Grid.Column="1" HorizontalAlignment="Left" Width="0" Fill="{StaticResource DxoAccent}" />
                                    </Grid>
                                    <TextBlock x:Name="YawText" Grid.Row="1" Grid.Column="2" Style="{StaticResource DxoCaption}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                    <TextBlock Grid.Row="2" Text="Roll" VerticalAlignment="Center" />
                                    <Grid Grid.Row="2" Grid.Column="1" Height="8" CornerRadius="4" Background="{StaticResource DxoSurfaceRaised}">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Rectangle x:Name="RollNeg" HorizontalAlignment="Right" Width="0" Fill="{StaticResource DxoAccent}" />
                                        <Rectangle x:Name="RollPos" Grid.Column="1" HorizontalAlignment="Left" Width="0" Fill="{StaticResource DxoAccent}" />
                                    </Grid>
                                    <TextBlock x:Name="RollText" Grid.Row="2" Grid.Column="2" Style="{StaticResource DxoCaption}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock x:Name="AccelText" Style="{StaticResource DxoCaption}" />
                            </StackPanel>

                            <!-- tilt bubble -->
                            <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="Tilt" Style="{StaticResource DxoCaption}" HorizontalAlignment="Center" />
                                <Canvas Width="110" Height="110">
                                    <Ellipse Width="110" Height="110" Stroke="{StaticResource DxoStroke}" StrokeThickness="2" />
                                    <Ellipse Canvas.Left="35" Canvas.Top="35" Width="40" Height="40" Stroke="{StaticResource DxoStroke}" StrokeThickness="1" />
                                    <Rectangle Canvas.Left="54" Canvas.Top="0" Width="1" Height="110" Fill="{StaticResource DxoStroke}" />
                                    <Rectangle Canvas.Left="0" Canvas.Top="54" Width="110" Height="1" Fill="{StaticResource DxoStroke}" />
                                    <Ellipse x:Name="TiltDot" Width="14" Height="14" Canvas.Left="48" Canvas.Top="48" Fill="#36D6FF" />
                                </Canvas>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="Calibration" Style="{StaticResource DxoSectionTitle}" Margin="0,12,0,6" />
                    <controls:SettingsCard x:Name="CalCard" Header="Gyro calibration"
                                           Description="Lay the controller on a flat surface, then click Calibrate. DXO also re-checks on its own whenever the pad rests still.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE713;" /></controls:SettingsCard.HeaderIcon>
                        <Button x:Name="CalButton" Content="Calibrate" Click="Calibrate_Click" />
                    </controls:SettingsCard>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,6,0,0">
                        <Ellipse x:Name="CalDot" Width="8" Height="8" VerticalAlignment="Center" />
                        <TextBlock x:Name="CalText" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <!-- ===== Right: gyro aim + CemuHook ===== -->
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Aim with gyro" Style="{StaticResource DxoSectionTitle}" Margin="0,0,0,6" />
                    <controls:SettingsCard Header="Gyro moves the mouse"
                                           Description="Turn the controller to aim, like Steam's gyro aiming. Works in any game that takes mouse input.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE962;" /></controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="MouseToggle" Toggled="Toggle_Changed" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Active" Description="Holding L2 means gyro aims only while you aim down sights.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7C9;" /></controls:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="HoldBox" Width="220" SelectionChanged="Combo_Changed">
                            <x:String>Always</x:String>
                            <x:String>While holding L2</x:String>
                            <x:String>While holding R2</x:String>
                            <x:String>While holding L1</x:String>
                            <x:String>While holding R1</x:String>
                            <x:String>While touching the touchpad</x:String>
                        </ComboBox>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Sensitivity" Description="1.0 = 10 pixels for every degree you turn">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9E9;" /></controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Slider x:Name="SensSlider" Width="180" Minimum="0.1" Maximum="5" StepFrequency="0.05" ValueChanged="Slider_Changed" />
                            <TextBlock x:Name="SensText" Width="40" VerticalAlignment="Center" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Steadiness" Description="Ignore turning slower than this, so hand tremor doesn't shake the aim">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE945;" /></controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Slider x:Name="DeadSlider" Width="180" Minimum="0" Maximum="5" StepFrequency="0.1" ValueChanged="Slider_Changed" />
                            <TextBlock x:Name="DeadText" Width="60" VerticalAlignment="Center" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Invert horizontal">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8AB;" /></controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="InvertXToggle" Toggled="Toggle_Changed" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Invert vertical">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8CB;" /></controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="InvertYToggle" Toggled="Toggle_Changed" />
                    </controls:SettingsCard>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,6,0,0">
                        <Ellipse x:Name="MouseDot" Width="8" Height="8" VerticalAlignment="Center" />
                        <TextBlock x:Name="MouseText" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="Emulators" Style="{StaticResource DxoSectionTitle}" Margin="0,12,0,6" />
                    <controls:SettingsCard Header="CemuHook motion server (DSU)"
                                           Description="Gives Cemu, Dolphin, Ryujinx and other emulators motion controls. In the emulator, add a DSU/CemuHook source at 127.0.0.1 and this port.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7FC;" /></controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="CemuToggle" Toggled="Toggle_Changed" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Port" Description="26760 is the standard; only change it if another app uses it">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE968;" /></controls:SettingsCard.HeaderIcon>
                        <NumberBox x:Name="PortBox" Width="140" Minimum="1024" Maximum="65535" SmallChange="1"
                                   SpinButtonPlacementMode="Compact" ValueChanged="Port_Changed" />
                    </controls:SettingsCard>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,6,0,0">
                        <Ellipse x:Name="CemuDot" Width="8" Height="8" VerticalAlignment="Center" />
                        <TextBlock x:Name="CemuText" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- footer -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SaveStatus" Style="{StaticResource DxoCaption}" VerticalAlignment="Center" />
            <Button x:Name="SaveButton" Grid.Column="1" Content="Save to profile" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
        </Grid>
    </Grid>
</Page>
