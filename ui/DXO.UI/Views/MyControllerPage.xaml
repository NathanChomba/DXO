<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DXO.UI.Views.MyControllerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:DXO.UI.Views"
    xmlns:controls2="using:DXO.UI.Controls">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource DxoPagePadding}" Spacing="{StaticResource DxoRowSpacing}" MaxWidth="1200">
            <TextBlock Text="My Controller" Style="{StaticResource DxoPageTitle}" />
            <TextBlock Text="What DXO knows about the connected controller." Style="{StaticResource DxoCaption}" />

            <!-- ===== Device information: 3-column grid like the reference ===== -->
            <TextBlock Text="Device information" Style="{StaticResource DxoSectionTitle}" />
            <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="360" ItemHeight="64">
                <controls:SettingsCard Header="Name" Description="{x:Bind Device.DeviceName, Mode=OneWay}" Margin="0,0,4,4">
                    <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7FC;" /></controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>
                <controls:SettingsCard Header="Controller type" Description="{x:Bind Device.KindText, Mode=OneWay}" Margin="0,0,4,4">
                    <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE946;" /></controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>
                <controls:SettingsCard Header="Connection" Description="{x:Bind Device.TransportText, Mode=OneWay}" Margin="0,0,4,4">
                    <controls:SettingsCard.HeaderIcon><FontIcon Glyph="{x:Bind Device.TransportGlyph, Mode=OneWay}" /></controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>
                <controls:SettingsCard Header="Battery" Description="{x:Bind Device.BatteryText, Mode=OneWay}" Margin="0,0,4,4">
                    <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE83F;" /></controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>
                <controls:SettingsCard Header="Report rate" Description="{x:Bind Device.RateText, Mode=OneWay}" Margin="0,0,4,4">
                    <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEC4A;" /></controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>
                <controls:SettingsCard Header="Active profile" Description="{x:Bind Device.ProfileName, Mode=OneWay}" Margin="0,0,4,4">
                    <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE77B;" /></controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>
            </VariableSizedWrapGrid>

            <!-- ===== Supported features ===== -->
            <TextBlock Text="Supported features" Style="{StaticResource DxoSectionTitle}" />
            <ItemsControl x:Name="Features">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="360" ItemHeight="48" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:Feature">
                        <Border Style="{StaticResource DxoCard}" Padding="14,0" Margin="0,0,4,4">
                            <Grid>
                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                                <FontIcon HorizontalAlignment="Right" FontSize="14" Glyph="{x:Bind Glyph}" Foreground="{x:Bind Brush}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== Live input ===== -->
            <TextBlock Text="Live input" Style="{StaticResource DxoSectionTitle}" />
            <Border Style="{StaticResource DxoCard}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- L2 / R2 pressure arcs beside the drawing (triggers aren't visible from the front) -->
                        <controls2:TriggerArc x:Name="L2Arc" Label="L2" VerticalAlignment="Center" />
                        <controls2:ControllerVisualizer x:Name="Visualizer" Grid.Column="1" MaxHeight="420" />
                        <controls2:TriggerArc x:Name="R2Arc" Grid.Column="2" Label="R2" Mirror="True" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Buttons" Style="{StaticResource DxoCaption}" />
                        <TextBlock Text="{x:Bind Device.Pressed, Mode=OneWay}" FontFamily="Cascadia Mono" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Gyro (raw)" Style="{StaticResource DxoCaption}" />
                        <TextBlock Text="{x:Bind Device.Gyro, Mode=OneWay}" FontFamily="Cascadia Mono" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
