<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DXO.UI.Views.VirtualDevicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource DxoPagePadding}" Spacing="4" MaxWidth="1200">
            <TextBlock Text="Virtual Device" Style="{StaticResource DxoPageTitle}" />
            <TextBlock Text="The controller games and Windows see instead of your physical one." Style="{StaticResource DxoCaption}" Margin="0,0,0,12" />

            <!-- Two-pane layout: modes on the left, options for the selected mode on the right -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!-- ===== Left: emulation mode ===== -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Emulation mode" Style="{StaticResource DxoSectionTitle}" Margin="0,0,0,6" />
                    <RadioButtons x:Name="Mode" SelectedIndex="1" SelectionChanged="Mode_SelectionChanged">
                        <RadioButton Content="Native mode - no virtual controller, games read your pad directly" />
                        <RadioButton Content="Xbox 360 controller - works with almost every PC game" />
                        <RadioButton Content="DualShock 4 - keeps PlayStation button prompts (coming later)" IsEnabled="False" />
                        <RadioButton Content="DualSense - native adaptive triggers in supported games (research)" IsEnabled="False" />
                    </RadioButtons>
                    <TextBlock x:Name="ModeNote" Style="{StaticResource DxoCaption}" Margin="0,8,0,0"
                               Text="Changing mode reconnects the virtual controller." />
                </StackPanel>

                <!-- ===== Right: options ===== -->
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Options" Style="{StaticResource DxoSectionTitle}" Margin="0,0,0,6" />

                    <controls:SettingsCard Header="Hide physical controller"
                                           Description="Uses HidHide so games only see the virtual controller and you don't get double input.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xED1A;" /></controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="True" IsEnabled="False" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Rumble passthrough"
                                           Description="Vibration a game sends to the virtual controller is played on your real one.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE995;" /></controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="True" IsEnabled="False" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Fix double input"
                                           Description="Re-hides your controller if a game still sees two. The pad may reconnect for a few seconds.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7BA;" Foreground="{StaticResource DxoWarning}" /></controls:SettingsCard.HeaderIcon>
                        <Button Content="Fix now" IsEnabled="False" />
                    </controls:SettingsCard>

                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,8,0,0"
                             Title="Read-only for now"
                             Message="These come from your profile (hide_physical, target). Engine controls for them arrive with milestone 3; until then edit profiles\default.toml." />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
