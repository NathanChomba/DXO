<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DXO.UI.Views.MappingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:dxo="using:DXO.UI.Controls">

    <Grid Padding="{StaticResource DxoPagePadding}" RowSpacing="8" ColumnSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Spacing="8">
            <StackPanel x:Name="Header">
                <TextBlock Text="Mappings" Style="{StaticResource DxoPageTitle}" />
            </StackPanel>
            <TextBlock x:Name="SubTitle" Style="{StaticResource DxoCaption}"
                       Text="Click a button on the controller (or in the list) and choose what it does. Changes apply straight away." />
            <!-- normal / shift layer -->
            <Border Style="{StaticResource DxoCard}" Padding="12,6">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <SelectorBar x:Name="LayerBar" SelectionChanged="LayerBar_SelectionChanged">
                        <SelectorBarItem x:Name="NormalItem" Text="Normal" IsSelected="True" />
                        <SelectorBarItem x:Name="ShiftItem" Text="Shift layer" />
                        <SelectorBarItem x:Name="CombosItem" Text="Combos" />
                    </SelectorBar>
                    <TextBlock x:Name="LayerHint" Grid.Column="1" Style="{StaticResource DxoCaption}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <StackPanel x:Name="ShiftPicker" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Hold for shift layer" VerticalAlignment="Center" />
                        <ComboBox x:Name="ShiftBox" Width="180" DisplayMemberPath="Label" SelectionChanged="ShiftBox_SelectionChanged" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ===== Left: controller + button list ===== -->
        <Grid Grid.Row="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MinHeight="200" />
                <RowDefinition Height="3*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource DxoCard}" Padding="12">
                <dxo:ControllerVisualizer x:Name="Visual" />
            </Border>
            <Border Grid.Row="1" Style="{StaticResource DxoCard}" Padding="4">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListView x:Name="ButtonList" SelectionMode="Single" SelectionChanged="ButtonList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" />
                                <TextBlock Grid.Column="1" Text="{Binding Summary}" Foreground="{StaticResource DxoAccent}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <!-- combos: add / remove -->
                <StackPanel x:Name="ComboBar" Grid.Row="1" Orientation="Horizontal" Spacing="8" Padding="8,6" Visibility="Collapsed">
                    <Button Click="AddCombo_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock Text="Add combo" /></StackPanel>
                    </Button>
                    <Button x:Name="RemoveComboButton" Content="Remove" Click="RemoveCombo_Click" />
                </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== Right: editor for the selected button ===== -->
        <ScrollViewer Grid.Row="1" Grid.Column="1">
            <StackPanel x:Name="Editor" Spacing="4" Padding="0,0,8,0">
                <TextBlock x:Name="EditTitle" Style="{StaticResource DxoSectionTitle}" Margin="0,0,0,6" />

                <!-- combos: which two buttons -->
                <StackPanel x:Name="ComboPanel" Spacing="4" Visibility="Collapsed">
                    <controls:SettingsCard Header="First button">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7FC;" /></controls:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ComboA" Width="190" DisplayMemberPath="Label" SelectionChanged="Changed" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Second button">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7FC;" /></controls:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ComboB" Width="190" DisplayMemberPath="Label" SelectionChanged="Changed" />
                    </controls:SettingsCard>
                </StackPanel>

                <!-- one button, three timings -->
                <SelectorBar x:Name="PressBar" Margin="-12,0,0,2" SelectionChanged="PressBar_SelectionChanged">
                    <SelectorBarItem x:Name="PressItem" Text="Press" IsSelected="True" />
                    <SelectorBarItem x:Name="HoldItem" Text="Hold" />
                    <SelectorBarItem x:Name="DoubleItem" Text="Double-tap" />
                </SelectorBar>
                <controls:SettingsCard x:Name="SlotCard" Header="Do something else when held" Visibility="Collapsed">
                    <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE916;" /></controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="SlotToggle" Toggled="Toggle_Changed" />
                </controls:SettingsCard>

                <controls:SettingsCard x:Name="TypeCard" Header="Does">
                    <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8AB;" /></controls:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="TypeBox" Width="190" SelectionChanged="TypeBox_SelectionChanged">
                        <x:String>Itself (normal)</x:String>
                        <x:String>Another button</x:String>
                        <x:String>Keyboard key</x:String>
                        <x:String>Mouse</x:String>
                        <x:String>Nothing (disabled)</x:String>
                        <x:String>Macro (a sequence)</x:String>
                        <x:String>Open an app, file or link</x:String>
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard x:Name="TargetCard" Header="Which one">
                    <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7C9;" /></controls:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="TargetBox" Width="190" DisplayMemberPath="Label" SelectionChanged="Changed" />
                </controls:SettingsCard>

                <!-- launch -->
                <StackPanel x:Name="LaunchPanel" Spacing="6" Visibility="Collapsed">
                    <TextBox x:Name="LaunchTarget" Header="What to open" PlaceholderText="C:\Program Files\App\app.exe, a folder, or https://..."
                             LostFocus="Launch_LostFocus" KeyDown="Launch_KeyDown" />
                    <TextBox x:Name="LaunchArgs" Header="Arguments (optional, programs only)" PlaceholderText="--minimized"
                             LostFocus="Launch_LostFocus" KeyDown="Launch_KeyDown" />
                    <Button Content="Browse..." Click="LaunchBrowse_Click" />
                </StackPanel>

                <!-- macro editor -->
                <StackPanel x:Name="MacroPanel" Spacing="6" Visibility="Collapsed">
                    <controls:SettingsCard Header="Repeat while held" Description="Off: plays once each time you press">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8EE;" /></controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="RepeatToggle" Toggled="Toggle_Changed" />
                    </controls:SettingsCard>
                    <StackPanel x:Name="MacroSteps" Spacing="6" />
                    <Button Click="AddStep_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock Text="Add step" /></StackPanel>
                    </Button>
                </StackPanel>

                <controls:SettingsCard x:Name="TurboCard" Header="Turbo" Description="Repeats the press quickly while you hold the button">
                    <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE945;" /></controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="TurboToggle" Toggled="Toggle_Changed" />
                </controls:SettingsCard>
                <controls:SettingsCard x:Name="TurboRateCard" Header="Turbo speed">
                    <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE916;" /></controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Slider x:Name="TurboSlider" Width="130" Minimum="2" Maximum="30" StepFrequency="1" ValueChanged="Slider_Changed" />
                        <TextBlock x:Name="TurboText" Width="44" VerticalAlignment="Center" />
                    </StackPanel>
                </controls:SettingsCard>
                <controls:SettingsCard x:Name="ToggleCard" Header="Toggle" Description="Press once to hold it down, press again to let go">
                    <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8B1;" /></controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="ToggleToggle" Toggled="Toggle_Changed" />
                </controls:SettingsCard>

                <!-- tap / hold / double-tap timing (whole profile) -->
                <StackPanel x:Name="TimingPanel" Spacing="4" Visibility="Collapsed">
                    <controls:SettingsCard Header="Hold time" Description="How long a press must last to count as a hold. Applies to every button in this profile.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE916;" /></controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Slider x:Name="HoldMsSlider" Width="130" Minimum="150" Maximum="800" StepFrequency="10" ValueChanged="Timing_Changed" />
                            <TextBlock x:Name="HoldMsText" Width="56" VerticalAlignment="Center" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Double-tap window" Description="The second press must come within this long. A single tap waits this long before it fires.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE916;" /></controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Slider x:Name="DoubleMsSlider" Width="130" Minimum="150" Maximum="500" StepFrequency="10" ValueChanged="Timing_Changed" />
                            <TextBlock x:Name="DoubleMsText" Width="56" VerticalAlignment="Center" />
                        </StackPanel>
                    </controls:SettingsCard>
                </StackPanel>

                <!-- dual-stage trigger points (whole profile) -->
                <StackPanel x:Name="StagePanel" Spacing="4" Visibility="Collapsed">
                    <controls:SettingsCard Header="Soft pull starts at" Description="How far the trigger is pulled before the soft-pull mapping begins.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9E9;" /></controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Slider x:Name="SoftSlider" Width="130" Minimum="5" Maximum="60" StepFrequency="1" ValueChanged="Timing_Changed" />
                            <TextBlock x:Name="SoftText" Width="44" VerticalAlignment="Center" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Full pull starts at" Description="How far before the full-pull mapping begins. Both triggers share these points.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9E9;" /></controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Slider x:Name="FullSlider" Width="130" Minimum="50" Maximum="100" StepFrequency="1" ValueChanged="Timing_Changed" />
                            <TextBlock x:Name="FullText" Width="44" VerticalAlignment="Center" />
                        </StackPanel>
                    </controls:SettingsCard>
                </StackPanel>

                <Button x:Name="ResetButton" Content="Reset this button" Click="Reset_Click" Margin="0,8,0,0" />
                <TextBlock x:Name="Hint" Style="{StaticResource DxoCaption}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- footer -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SaveStatus" Style="{StaticResource DxoCaption}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Reset all" Click="ResetAll_Click" />
            <Button x:Name="SaveButton" Grid.Column="2" Content="Save to profile" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
        </Grid>
    </Grid>
</Page>
