<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DXO.UI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource DxoPagePadding}" Spacing="4" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource DxoPageTitle}" />

            <TextBlock Text="Drivers" Style="{StaticResource DxoSectionTitle}" />
            <controls:SettingsCard x:Name="VigemCard" Header="ViGEmBus" Description="Creates the virtual controller games see.">
                <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7FC;" /></controls:SettingsCard.HeaderIcon>
                <TextBlock x:Name="VigemStatus" Style="{StaticResource DxoValue}" />
            </controls:SettingsCard>
            <controls:SettingsCard x:Name="HidHideCard" Header="HidHide" Description="Hides your physical controller from games.">
                <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xED1A;" /></controls:SettingsCard.HeaderIcon>
                <TextBlock x:Name="HidHideStatus" Style="{StaticResource DxoValue}" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="Run setup" Description="Check the drivers and connect a controller, step by step." IsClickEnabled="True" Click="RunSetup_Click">
                <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9D5;" /></controls:SettingsCard.HeaderIcon>
            </controls:SettingsCard>

            <TextBlock Text="Safety" Style="{StaticResource DxoSectionTitle}" />
            <controls:SettingsCard Header="Unhide all controllers"
                                   Description="Use this if a controller stopped working in other apps after DXO closed unexpectedly.">
                <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7BA;" Foreground="{StaticResource DxoWarning}" /></controls:SettingsCard.HeaderIcon>
                <Button Content="Unhide all" Click="UnhideAll_Click" />
            </controls:SettingsCard>

            <TextBlock Text="Controllers" Style="{StaticResource DxoSectionTitle}" />
            <controls:SettingsCard Header="Other controllers (experimental)"
                                   Description="Also use Switch Pro Controllers and generic USB / Bluetooth gamepads, alongside PlayStation ones. DXO picks them up straight away.">
                <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7FC;" /></controls:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="GenericToggle" Toggled="Generic_Toggled" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="Control DXO with your controller"
                                   Description="Move around this app with the D-pad or left stick. Cross/A selects, Circle/B goes back, the bumpers flip pages, Options shows the menu, the right stick scrolls. Works even when the controller isn't emulated; only active while DXO is the window in front.">
                <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7FC;" /></controls:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="NavToggle" Toggled="Nav_Toggled" />
            </controls:SettingsCard>

            <TextBlock Text="Animations" Style="{StaticResource DxoSectionTitle}" />
            <controls:SettingsCard Header="Window animation scale" Description="The controller card growing out of a pill and closing again.">
                <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE737;" /></controls:SettingsCard.HeaderIcon>
                <ComboBox x:Name="WindowScaleBox" Width="160" SelectionChanged="Scale_Changed" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="Transition animation scale" Description="Moving from one page to another.">
                <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8AB;" /></controls:SettingsCard.HeaderIcon>
                <ComboBox x:Name="TransitionScaleBox" Width="160" SelectionChanged="Scale_Changed" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="Animator duration scale" Description="Smaller fades, such as the card's contents and the dimmed background.">
                <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE916;" /></controls:SettingsCard.HeaderIcon>
                <ComboBox x:Name="AnimatorScaleBox" Width="160" SelectionChanged="Scale_Changed" />
            </controls:SettingsCard>

            <TextBlock Text="App" Style="{StaticResource DxoSectionTitle}" />
            <controls:SettingsCard Header="Start with Windows" Description="DXO starts in the tray when you sign in, so your controller is ready straight away.">
                <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7E8;" /></controls:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="StartToggle" Toggled="Start_Toggled" />
            </controls:SettingsCard>
            <TextBlock x:Name="StartNote" Style="{StaticResource DxoCaption}" TextWrapping="Wrap" Margin="4,0,0,4" />
            <controls:SettingsCard Header="Close to tray" Description="Closing the window keeps DXO running in the tray. Right-click the tray icon to exit.">
                <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8A7;" /></controls:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="CloseToggle" Toggled="Tray_Toggled" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="Minimise to tray" Description="Minimising hides DXO in the tray instead of the taskbar.">
                <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE921;" /></controls:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="MinToggle" Toggled="Tray_Toggled" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="Profiles folder" Description="Where your profile TOML files live." IsClickEnabled="True" Click="OpenProfiles_Click">
                <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8B7;" /></controls:SettingsCard.HeaderIcon>
            </controls:SettingsCard>

            <TextBlock Text="Updates" Style="{StaticResource DxoSectionTitle}" />
            <controls:SettingsCard Header="Look for updates at"
                                   Description="A public GitHub repo (owner/name), or the https address of a JSON file with version and url.">
                <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE774;" /></controls:SettingsCard.HeaderIcon>
                <TextBox x:Name="UpdateSourceBox" Width="280" PlaceholderText="owner/repo or https://..." LostFocus="UpdateSource_LostFocus" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="Check when DXO starts">
                <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE895;" /></controls:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="UpdateToggle" Toggled="UpdateToggle_Toggled" />
            </controls:SettingsCard>
            <controls:SettingsCard x:Name="UpdateCard" Header="Check now">
                <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE72C;" /></controls:SettingsCard.HeaderIcon>
                <Button x:Name="CheckButton" Content="Check for updates" Click="CheckUpdates_Click" />
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
