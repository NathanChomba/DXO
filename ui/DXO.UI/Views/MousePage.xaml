<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DXO.UI.Views.MousePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <Grid Padding="{StaticResource DxoPagePadding}" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <StackPanel x:Name="Header">
                <TextBlock Text="Mouse" Style="{StaticResource DxoPageTitle}" />
            </StackPanel>
            <TextBlock x:Name="SubTitle" Style="{StaticResource DxoCaption}"
                       Text="Use the touchpad or a stick as a mouse. Changes apply straight away; Save keeps them in the profile." />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <Grid ColumnSpacing="16" Padding="0,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="Touchpad" Style="{StaticResource DxoSectionTitle}" Margin="0,0,0,6" />
                    <controls:SettingsCard Header="Touchpad moves the mouse" Description="Slide a finger like on a laptop trackpad.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEFA5;" /></controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="TouchToggle" Toggled="Toggle_Changed" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Speed">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEC4A;" /></controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Slider x:Name="TouchSpeed" Width="180" Minimum="0.2" Maximum="4" StepFrequency="0.1" ValueChanged="Slider_Changed" />
                            <TextBlock x:Name="TouchSpeedText" Width="44" VerticalAlignment="Center" Style="{StaticResource DxoMono}" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Press the touchpad to click" Description="One finger = left click, two fingers = right click. Games stop seeing the touchpad press.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE962;" /></controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="ClickToggle" Toggled="Toggle_Changed" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Two fingers scroll" Description="Slide two fingers to scroll up, down and sideways. The page follows your fingers.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8CB;" /></controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="ScrollToggle" Toggled="Toggle_Changed" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Pinch to zoom" Description="Move two fingers apart or together to zoom, in apps that zoom with Ctrl + mouse wheel.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8A3;" /></controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="PinchToggle" Toggled="Toggle_Changed" />
                    </controls:SettingsCard>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Stick" Style="{StaticResource DxoSectionTitle}" Margin="0,0,0,6" />
                    <controls:SettingsCard Header="Stick moves the mouse" Description="Games stop seeing that stick while this is on.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7FC;" /></controls:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="StickBox" Width="150" SelectionChanged="Combo_Changed">
                            <x:String>Off</x:String>
                            <x:String>Left stick</x:String>
                            <x:String>Right stick</x:String>
                        </ComboBox>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Speed" Description="How fast the cursor goes with the stick pushed all the way.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEC4A;" /></controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Slider x:Name="StickSpeed" Width="180" Minimum="200" Maximum="4000" StepFrequency="50" ValueChanged="Slider_Changed" />
                            <TextBlock x:Name="StickSpeedText" Width="70" VerticalAlignment="Center" Style="{StaticResource DxoMono}" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Response" Description="How the cursor speeds up as you push the stick further.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9D9;" /></controls:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="CurveBox" Width="170" SelectionChanged="Curve_Changed">
                            <x:String>Standard</x:String>
                            <x:String>Linear</x:String>
                            <x:String>Precision</x:String>
                            <x:String>Custom curve</x:String>
                        </ComboBox>
                    </controls:SettingsCard>
                    <!-- custom Bezier curve: two handles, drawn live -->
                    <Border x:Name="CurvePanel" Style="{StaticResource DxoCard}" Visibility="Collapsed">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- stick push runs left to right, cursor speed bottom to top -->
                            <Border Width="132" Height="132" BorderThickness="1" BorderBrush="{StaticResource DxoStroke}" CornerRadius="4"
                                    VerticalAlignment="Top">
                                <Canvas Width="120" Height="120" Margin="5">
                                    <Line X1="0" Y1="120" X2="120" Y2="0" Stroke="{StaticResource DxoStroke}" StrokeThickness="1" StrokeDashArray="3,3" />
                                    <Polyline x:Name="CurveLine" Stroke="{StaticResource DxoAccent}" StrokeThickness="2" />
                                </Canvas>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <Slider x:Name="CurveX1" Header="Centre handle: how long it stays slow" Minimum="0" Maximum="1" StepFrequency="0.05" ValueChanged="CurveSlider_Changed" />
                                <Slider x:Name="CurveY1" Header="Centre handle: speed near the centre" Minimum="0" Maximum="1" StepFrequency="0.05" ValueChanged="CurveSlider_Changed" />
                                <Slider x:Name="CurveX2" Header="Edge handle: where it starts to rush" Minimum="0" Maximum="1" StepFrequency="0.05" ValueChanged="CurveSlider_Changed" />
                                <Slider x:Name="CurveY2" Header="Edge handle: speed before the edge" Minimum="0" Maximum="1" StepFrequency="0.05" ValueChanged="CurveSlider_Changed" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="In games" Style="{StaticResource DxoSectionTitle}" Margin="0,12,0,6" />
                    <controls:SettingsCard Header="Step aside for full-screen games"
                                           Description="While a full-screen game or video is in front, the touchpad and stick go back to being a touchpad and a stick. Gyro aiming is not affected.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE740;" /></controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="FullscreenToggle" Toggled="Toggle_Changed" />
                    </controls:SettingsCard>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,6,0,0">
                        <Ellipse x:Name="FullscreenDot" Width="8" Height="8" VerticalAlignment="Center" />
                        <TextBlock x:Name="FullscreenText" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Style="{StaticResource DxoCard}" Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource DxoCaption}" TextWrapping="Wrap"
                                   Text="Map buttons to mouse clicks on the Buttons tab, and aim by turning the controller on the Motion tab." />
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SaveStatus" Style="{StaticResource DxoCaption}" VerticalAlignment="Center" />
            <Button x:Name="SaveButton" Grid.Column="1" Content="Save to profile" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
        </Grid>
    </Grid>
</Page>
