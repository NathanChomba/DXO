<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DXO.UI.Views.ProfileEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DXO.UI.ViewModels">

    <!-- One place for everything a profile holds. The tabs host the existing
         pages; all but Library edit the profile the selected controller runs.
         The controller strip (below the title) slides down from the top bar
         when you land here, so it's clear which controller you're editing:
         single-click a pill to switch, double-click for its details card. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Padding="24,16,24,0" Spacing="8">
            <TextBlock Text="Profiles" Style="{StaticResource DxoPageTitle}" />

            <!-- controller strip: animates in; single-click selects, double-click opens the card -->
            <StackPanel x:Name="StripHost" Orientation="Horizontal">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="StripShift" />
                </StackPanel.RenderTransform>
                <ItemsControl x:Name="PadStrip">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PadViewModel">
                            <!-- outer = selection ring, inner = the pill (same look as the top bar) -->
                            <Border Tapped="StripPill_Tapped" DoubleTapped="StripPill_DoubleTapped"
                                    Background="Transparent" BorderThickness="2" CornerRadius="18"
                                    BorderBrush="{x:Bind SelectionBrush, Mode=OneWay}"
                                    ToolTipService.ToolTip="Click to edit this controller · double-click for details"
                                    AutomationProperties.Name="{x:Bind Name, Mode=OneWay}">
                                <Border Height="32" CornerRadius="16" Padding="12,0"
                                        Background="{StaticResource DxoSurfaceLow}" BorderThickness="1"
                                        BorderBrush="{StaticResource DxoStroke}">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{x:Bind LightBrush, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                                        <TextBlock Text="|" Foreground="{StaticResource DxoStroke}" VerticalAlignment="Center" />
                                        <FontIcon Glyph="{x:Bind TransportGlyph, Mode=OneWay}" FontSize="12" Foreground="{StaticResource DxoTextSecondary}" />
                                        <TextBlock Text="{x:Bind RateText, Mode=OneWay}" Style="{StaticResource DxoMono}" FontSize="12"
                                                   Foreground="{StaticResource DxoSecondary}" VerticalAlignment="Center" />
                                        <Grid Width="22" Height="12" VerticalAlignment="Center">
                                            <Border Width="19" HorizontalAlignment="Left" BorderThickness="1.5" CornerRadius="2.5"
                                                    BorderBrush="{StaticResource DxoTextMuted}" />
                                            <Rectangle Width="{x:Bind BatteryFill, Mode=OneWay}" Height="6" RadiusX="1" RadiusY="1"
                                                       Margin="3,0,0,0" HorizontalAlignment="Left" Fill="{StaticResource DxoSuccess}" />
                                            <Rectangle Width="2" Height="4" HorizontalAlignment="Right" Fill="{StaticResource DxoTextMuted}" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind BatteryText, Mode=OneWay}" Style="{StaticResource DxoMono}" FontSize="12" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind HiddenVisibility, Mode=OneWay}">
                                            <FontIcon Glyph="&#xEA18;" FontSize="12" Foreground="{StaticResource DxoAccentLight}" />
                                            <TextBlock Text="HIDDEN" Style="{StaticResource DxoMono}" FontSize="10"
                                                       Foreground="{StaticResource DxoAccentLight}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border Padding="8,2" CornerRadius="10" Background="{StaticResource DxoAccentSoft}" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Profile, Mode=OneWay}" FontSize="12" Foreground="{StaticResource DxoAccentLight}" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border x:Name="EditingDot" Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" Background="{StaticResource DxoAccent}" />
                <TextBlock x:Name="EditingText" Style="{StaticResource DxoCaption}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <SelectorBar x:Name="Tabs" Margin="-12,6,0,0" SelectionChanged="Tabs_SelectionChanged">
                <SelectorBarItem Text="Library" Tag="library" />
                <SelectorBarItem Text="Buttons" Tag="buttons" />
                <SelectorBarItem Text="Mouse" Tag="mouse" />
                <SelectorBarItem Text="Motion" Tag="motion" />
                <SelectorBarItem Text="Rumble and sound" Tag="rumble" />
                <SelectorBarItem Text="Triggers" Tag="triggers" />
                <SelectorBarItem Text="Lighting" Tag="lighting" />
            </SelectorBar>
        </StackPanel>

        <Frame x:Name="Inner" Grid.Row="1" />
    </Grid>
</Page>
