<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DXO.UI.Views.ProfileEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- One place for everything a profile holds. The tabs host the existing
         pages; all but Library edit the profile the selected controller runs. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Padding="24,16,24,0" Spacing="4">
            <TextBlock Text="Profiles" Style="{StaticResource DxoPageTitle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border x:Name="EditingDot" Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" Background="{StaticResource DxoAccent}" />
                <TextBlock x:Name="EditingText" Style="{StaticResource DxoCaption}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <SelectorBar x:Name="Tabs" Margin="-12,6,0,0" SelectionChanged="Tabs_SelectionChanged">
                <SelectorBarItem Text="Library" Tag="library" />
                <SelectorBarItem Text="Buttons" Tag="buttons" />
                <SelectorBarItem Text="Mouse" Tag="mouse" />
                <SelectorBarItem Text="Motion" Tag="motion" />
                <SelectorBarItem Text="Rumble and sound" Tag="rumble" />
                <SelectorBarItem Text="Triggers" Tag="triggers" />
                <SelectorBarItem Text="Lighting" Tag="lighting" />
            </SelectorBar>
        </StackPanel>

        <Frame x:Name="Inner" Grid.Row="1" />
    </Grid>
</Page>
