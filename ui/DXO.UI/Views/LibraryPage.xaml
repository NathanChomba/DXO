<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DXO.UI.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <!-- The small round buttons at the top of the library. -->
        <Style x:Key="RoundIcon" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#66000000" />
        </Style>
        <!-- Buttons on the details screen: flat and translucent, outlined in violet when highlighted. -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Height" Value="58" />
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#4D3A3A44" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource DxoAccent}" />
            <Setter Property="FocusVisualPrimaryThickness" Value="3" />
            <Setter Property="FocusVisualSecondaryThickness" Value="0" />
            <Setter Property="FocusVisualMargin" Value="-3" />
        </Style>
        <!-- Translucent panels on the details screen. -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="#8C1C1C22" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
    </Page.Resources>

    <Grid>
        <!-- ===================== the library ===================== -->
        <Grid x:Name="LibraryView">
            <!-- The highlighted game's artwork, behind everything. Two layers so one can fade into the other. -->
            <!-- Their own layer: the cross-fade reorders these two, and must never lift one over the page. -->
            <Grid x:Name="BackdropHost" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <!-- The slow zoom and drift of the "living backdrop" setting. -->
                    <CompositeTransform x:Name="BackdropMotion" />
                </Grid.RenderTransform>
                <!-- Pictures are painted as fills, never as Image controls: an Image set to fill
                     the screen asks for its picture's own shape, which made the page lay out wider
                     than the window and pushed the game row sideways whenever the backdrop changed. -->
                <Border x:Name="BackdropA" Opacity="0">
                    <Border.Background><ImageBrush x:Name="BackdropABrush" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" /></Border.Background>
                </Border>
                <Border x:Name="BackdropB" Opacity="0">
                    <Border.Background><ImageBrush x:Name="BackdropBBrush" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" /></Border.Background>
                </Border>
                <!-- Animated backgrounds. Sized from code to the page (0 until then) for the same reason;
                     a GIF needs an Image to animate. -->
                <Image x:Name="BackdropGif" Stretch="UniformToFill" Width="0" Height="0" Opacity="0"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                <MediaPlayerElement x:Name="BackdropVideo" Stretch="UniformToFill" AreTransportControlsEnabled="False" Opacity="0"
                                    Width="0" Height="0" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <!-- Darkened towards the left and the bottom so text and tiles stay readable. -->
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#E6131318" Offset="0" />
                        <GradientStop Color="#00131318" Offset="0.6" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                        <GradientStop Color="#F2131318" Offset="0" />
                        <GradientStop Color="#00131318" Offset="0.55" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid Padding="28,16,28,18" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <Button x:Name="SearchButton" Style="{StaticResource RoundIcon}" ToolTipService.ToolTip="Search games">
                        <FontIcon Glyph="&#xE721;" FontSize="16" />
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <TextBox x:Name="SearchBox" Width="240" PlaceholderText="Search games" TextChanged="Search_TextChanged" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="FilterButton" Style="{StaticResource RoundIcon}" ToolTipService.ToolTip="Show a genre or favourites" Click="Filter_Click">
                        <FontIcon Glyph="&#xE71C;" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource RoundIcon}" ToolTipService.ToolTip="Scan for installed games" Click="Scan_Click">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource RoundIcon}" ToolTipService.ToolTip="Add a game" Click="Add_Click">
                        <FontIcon Glyph="&#xE710;" FontSize="16" />
                    </Button>
                </StackPanel>

                <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                    <ProgressRing x:Name="ScanRing" IsActive="False" Width="28" Height="28" />
                    <TextBlock x:Name="EmptyText" Style="{StaticResource DxoCaption}" HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="8,0,0,0">
                    <TextBlock x:Name="RowCaption" Text="Recently played" Style="{StaticResource DxoCaption}" />
                    <TextBlock x:Name="RowTitle" Text="Jump back in" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>

                <!-- One row; it scrolls sideways. The top padding is room for the highlighted tile to grow into. -->
                <GridView x:Name="GameGrid" Grid.Row="3" Height="262" Padding="8,34,8,8"
                          SelectionMode="Single" SelectionChanged="Game_Selected"
                          IsItemClickEnabled="True" ItemClick="Game_Click" RightTapped="Game_RightTapped"
                          ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                          ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Vertical" MaximumRowsOrColumns="1" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <!-- Box-art shape (2:3), so a game's cover is always shown whole. -->
                            <Grid Width="{Binding TileWidth}" Height="{Binding TileHeight}" CornerRadius="6" Background="#FF0E0E12">
                                <TextBlock Text="{Binding Initials}" FontSize="40" FontWeight="SemiBold" Foreground="{StaticResource DxoTextMuted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <!-- Never cropped: a picture of another shape gets a dark border instead. -->
                                <Image Source="{Binding Cover}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <FontIcon Glyph="&#xE735;" FontSize="13" Foreground="{StaticResource DxoWarning}" Visibility="{Binding StarVisibility}"
                                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" />
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- The highlighted game's name and one line about it, under its tile and
                     following it along the row. Messages ("Starting...") use the second line for a moment. -->
                <Canvas x:Name="InfoLayer" Grid.Row="4" Height="54" Margin="0,-4,0,0">
                    <StackPanel x:Name="InfoPanel" Spacing="3">
                        <TextBlock x:Name="InfoTitle" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon x:Name="InfoIcon" FontSize="11" Glyph="&#xE768;" Foreground="{StaticResource DxoAccent}" Visibility="Collapsed" VerticalAlignment="Center" />
                            <TextBlock x:Name="InfoSub" FontSize="12" FontWeight="SemiBold" CharacterSpacing="40" Opacity="0.65"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Canvas>
            </Grid>
        </Grid>

        <!-- ===================== one game's details ===================== -->
        <Grid x:Name="DetailsView" Visibility="Collapsed" Opacity="0">
            <!-- The game's own artwork, blurred and dimmed. -->
<Border x:Name="DetailBlur" Opacity="0.75" IsHitTestVisible="False">
                    <Border.Background><ImageBrush x:Name="DetailBlurBrush" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" /></Border.Background>
                </Border>
            <Border Background="#B8131318" IsHitTestVisible="False" />

            <Grid Padding="56,34,56,26" RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="2">
                    <TextBlock x:Name="DetailName" FontSize="34" FontWeight="SemiLight" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DetailMeta" FontSize="13" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Grid Grid.Row="1" ColumnSpacing="10" MaxHeight="470" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="0.42*" MinWidth="220" MaxWidth="320" />
                    </Grid.ColumnDefinitions>

                    <!-- left: square cover, then the facts -->
                    <Grid Width="210" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="315" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid CornerRadius="4" Background="#FF0E0E12">
                            <TextBlock x:Name="DetailInitials" FontSize="56" FontWeight="SemiBold" Foreground="{StaticResource DxoTextMuted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="DetailArt" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <Border Grid.Row="1" Style="{StaticResource CardPanel}">
                            <Grid RowSpacing="8" ColumnSpacing="12" VerticalAlignment="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Last Played" Opacity="0.75" />
                                <TextBlock x:Name="FactLastPlayed" Grid.Column="1" />
                                <TextBlock Grid.Row="1" Text="Time Played" Opacity="0.75" />
                                <TextBlock x:Name="FactTimePlayed" Grid.Row="1" Grid.Column="1" />
                                <TextBlock Grid.Row="2" Text="Release Date" Opacity="0.75" />
                                <TextBlock x:Name="FactReleased" Grid.Row="2" Grid.Column="1" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- middle: the wide picture, or the trailer playing -->
                    <Grid Grid.Column="1" CornerRadius="4" Background="#FF0E0E12">
<Border x:Name="DetailWide">
                    <Border.Background><ImageBrush x:Name="DetailWideBrush" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" /></Border.Background>
                </Border>
                        <MediaPlayerElement x:Name="Trailer" Visibility="Collapsed" Stretch="Uniform" AreTransportControlsEnabled="True" />
                        <!-- Choose this game's backdrop (when it has several and Settings is on "pick one"). -->
                        <StackPanel x:Name="BackdropPicker" Orientation="Horizontal" Spacing="8" Margin="12"
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="Collapsed" />
                        <Button x:Name="TrailerButton" Width="64" Height="64" CornerRadius="32" Padding="0" BorderThickness="0"
                                Background="#E6FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                ToolTipService.ToolTip="Play the trailer" Click="Trailer_Click" Visibility="Collapsed"
                                FocusVisualPrimaryBrush="{StaticResource DxoAccent}" FocusVisualPrimaryThickness="3" FocusVisualSecondaryThickness="0">
                            <FontIcon Glyph="&#xE768;" FontSize="24" Foreground="#FF131318" Margin="4,0,0,0" />
                        </Button>
                    </Grid>

                    <!-- right: description -->
                    <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Description" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock x:Name="DetailDescription" TextWrapping="Wrap" LineHeight="22" />
                                <HyperlinkButton x:Name="RawgCredit" Content="Data from RAWG" NavigateUri="https://rawg.io" Padding="0" Visibility="Collapsed" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- bottom: actions on the left, button hints on the right -->
                <Grid Grid.Row="2">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button x:Name="PlayButton" Style="{StaticResource CardButton}" Width="250" Click="Play_Click">
                            <TextBlock Text="PLAY" FontWeight="SemiBold" CharacterSpacing="60" />
                        </Button>
                        <Button x:Name="AchievementsButton" Style="{StaticResource CardButton}" Width="58" Click="Achievements_Click"
                                ToolTipService.ToolTip="Achievements (Steam)">
                            <FontIcon Glyph="&#xE734;" FontSize="20" />
                        </Button>
                        <Button x:Name="LauncherButton" Style="{StaticResource CardButton}" Width="58" Click="Launcher_Click">
                            <FontIcon Glyph="&#xE719;" FontSize="20" />
                        </Button>
                        <Button x:Name="MoreButton" Style="{StaticResource CardButton}" Padding="20,0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE946;" FontSize="16" />
                                <TextBlock Text="GAME DETAILS" FontWeight="SemiBold" CharacterSpacing="40" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout Placement="TopEdgeAlignedLeft">
                                    <MenuFlyoutItem Text="Edit details and pictures" Click="Edit_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="FavouriteItem" Text="Add to favourites" Click="Favourite_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE734;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Game profiles" Click="Profiles_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7FC;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="FolderItem" Text="Open install folder" Click="Folder_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Remove from library" Click="Remove_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <!-- Button hints, as on the reference. Clickable for mouse users. -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource CardPanel}" Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="18">
                            <HyperlinkButton Padding="0" Click="Play_Click" Foreground="#FFE4E1E9">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock x:Name="HintSelect" Text="&#x2715;" Foreground="#FF7DA7FF" FontWeight="Bold" />
                                    <TextBlock Text="Play" FontSize="13" />
                                </StackPanel>
                            </HyperlinkButton>
                            <HyperlinkButton Padding="0" Click="Back_Click" Foreground="#FFE4E1E9">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock x:Name="HintBack" Text="&#x25CB;" Foreground="#FFFF6B7A" FontWeight="Bold" />
                                    <TextBlock Text="Back" FontSize="13" />
                                </StackPanel>
                            </HyperlinkButton>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
