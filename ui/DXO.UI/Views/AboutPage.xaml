<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DXO.UI.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Padding="{StaticResource DxoPagePadding}" Spacing="8" MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock Text="About DXO" Style="{StaticResource DxoPageTitle}" />
        <Border Style="{StaticResource DxoCard}">
            <StackPanel Spacing="6">
                <TextBlock x:Name="VersionText" Text="DXO" FontWeight="SemiBold" />
                <TextBlock Text="Open-source controller mapper for DualSense, DualSense Edge, DualShock 4 and generic gamepads." Style="{StaticResource DxoCaption}" />
                <TextBlock Text="No ads, no account, no telemetry. Everything runs on your PC." Style="{StaticResource DxoCaption}" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource DxoCard}">
            <StackPanel Spacing="6">
                <TextBlock Text="Built on" FontWeight="SemiBold" />
                <TextBlock Text="ViGEmBus and HidHide by Nefarius · hidapi · Windows App SDK · CommunityToolkit" Style="{StaticResource DxoCaption}" />
                <TextBlock Text="Report layouts referenced from the Linux hid-playstation driver." Style="{StaticResource DxoCaption}" />
                <TextBlock Text="DXO is not affiliated with Sony or Microsoft. PlayStation, DualSense and DualShock are trademarks of Sony Interactive Entertainment." Style="{StaticResource DxoCaption}" />
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
