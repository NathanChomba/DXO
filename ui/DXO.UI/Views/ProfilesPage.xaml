<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DXO.UI.Views.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <Grid Padding="{StaticResource DxoPagePadding}" ColumnSpacing="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2">
            <TextBlock Text="Profiles" Style="{StaticResource DxoPageTitle}" />
            <TextBlock Text="A profile is a full setup: sticks, remaps, lighting and what games see. Add a game's .exe to switch to it automatically." Style="{StaticResource DxoCaption}" />
        </StackPanel>

        <!-- ===== Left: profile list ===== -->
        <Border Grid.Row="1" Style="{StaticResource DxoCard}" Padding="8">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListView x:Name="List" SelectionMode="Single" SelectionChanged="List_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="0,6" Spacing="2">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource DxoCaption}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                    <Button Click="New_Click" ToolTipService.ToolTip="New profile">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock Text="New" /></StackPanel>
                    </Button>
                    <Button x:Name="DuplicateButton" Click="Duplicate_Click" ToolTipService.ToolTip="Duplicate">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                    </Button>
                    <Button x:Name="DeleteButton" Click="Delete_Click" ToolTipService.ToolTip="Delete">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    </Button>
                    <Button Click="OpenFolder_Click" ToolTipService.ToolTip="Open profiles folder">
                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Right: editor ===== -->
        <Grid Grid.Row="1" Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="EditorScroll">
                <StackPanel x:Name="Editor" Spacing="4" Padding="0,0,12,0">

                    <TextBlock Text="General" Style="{StaticResource DxoSectionTitle}" Margin="0,0,0,6" />
                    <controls:SettingsCard Header="Name">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8AC;" /></controls:SettingsCard.HeaderIcon>
                        <TextBox x:Name="NameBox" Width="260" TextChanged="Text_Changed" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Switch to this profile for these games"
                                           Description="Executable names, comma separated, e.g. eldenring.exe, cs2.exe">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7FC;" /></controls:SettingsCard.HeaderIcon>
                        <TextBox x:Name="GamesBox" Width="260" PlaceholderText="none (manual only)" TextChanged="Text_Changed" />
                    </controls:SettingsCard>

                    <TextBlock Text="Sticks" Style="{StaticResource DxoSectionTitle}" />
                    <controls:SettingsExpander Header="Left stick" Description="Deadzone, outer limit and response curve" IsExpanded="True">
                        <controls:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE7AD;" /></controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard Header="Deadzone" Description="Movement inside this is ignored (stops drift)">
                                <Slider x:Name="LDead" Width="220" Minimum="0" Maximum="0.5" StepFrequency="0.01" ValueChanged="Slider_Changed" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="Outer limit" Description="Reach full tilt before the physical edge">
                                <Slider x:Name="LOuter" Width="220" Minimum="0.5" Maximum="1" StepFrequency="0.01" ValueChanged="Slider_Changed" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="Response curve" Description="Power: finer aim near the centre. Smooth: blend.">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="LCurve" Width="120" SelectionChanged="Curve_Changed">
                                        <x:String>Linear</x:String>
                                        <x:String>Power</x:String>
                                        <x:String>Smooth</x:String>
                                    </ComboBox>
                                    <Slider x:Name="LCurveParam" Width="140" Minimum="0.2" Maximum="3" StepFrequency="0.05" ValueChanged="Slider_Changed" />
                                </StackPanel>
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="Invert Y">
                                <ToggleSwitch x:Name="LInvert" Toggled="Toggle_Changed" />
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>
                    <controls:SettingsExpander Header="Right stick" Description="Deadzone, outer limit and response curve">
                        <controls:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE7AD;" /></controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard Header="Deadzone">
                                <Slider x:Name="RDead" Width="220" Minimum="0" Maximum="0.5" StepFrequency="0.01" ValueChanged="Slider_Changed" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="Outer limit">
                                <Slider x:Name="ROuter" Width="220" Minimum="0.5" Maximum="1" StepFrequency="0.01" ValueChanged="Slider_Changed" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="Response curve">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="RCurve" Width="120" SelectionChanged="Curve_Changed">
                                        <x:String>Linear</x:String>
                                        <x:String>Power</x:String>
                                        <x:String>Smooth</x:String>
                                    </ComboBox>
                                    <Slider x:Name="RCurveParam" Width="140" Minimum="0.2" Maximum="3" StepFrequency="0.05" ValueChanged="Slider_Changed" />
                                </StackPanel>
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="Invert Y">
                                <ToggleSwitch x:Name="RInvert" Toggled="Toggle_Changed" />
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>
                    <controls:SettingsCard Header="Trigger deadzone" Description="Ignore light trigger touches">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE945;" /></controls:SettingsCard.HeaderIcon>
                        <Slider x:Name="TrigDead" Width="220" Minimum="0" Maximum="0.3" StepFrequency="0.01" ValueChanged="Slider_Changed" />
                    </controls:SettingsCard>

                    <TextBlock Text="Button mappings" Style="{StaticResource DxoSectionTitle}" />
                    <controls:SettingsCard x:Name="MappingsCard" Header="Button mappings" IsClickEnabled="True" Click="EditMappings_Click">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8AB;" /></controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.Description>
                            <TextBlock x:Name="MappingsSummary" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                    </controls:SettingsCard>

                    <TextBlock Text="Lighting and rumble" Style="{StaticResource DxoSectionTitle}" />
                    <controls:SettingsCard Header="Light bar colour">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE790;" /></controls:SettingsCard.HeaderIcon>
                        <DropDownButton x:Name="ColorButton">
                            <Border x:Name="ColorSwatch" Width="48" Height="18" CornerRadius="4" />
                            <DropDownButton.Flyout>
                                <Flyout>
                                    <ColorPicker x:Name="LightPicker" ColorSpectrumShape="Ring" IsAlphaEnabled="False"
                                                 IsMoreButtonVisible="False" ColorChanged="LightPicker_ColorChanged" />
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </controls:SettingsCard>
                    <TextBlock Style="{StaticResource DxoCaption}" Margin="4,8,0,0" TextWrapping="Wrap"
                               Text="What games see (Xbox 360, DualShock 4 or your real controller) and hiding belong to each controller, not the profile. Set them by clicking the controller at the top." />
                    <controls:SettingsCard Header="Rumble passthrough">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE995;" /></controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="RumbleToggle" Toggled="Toggle_Changed" />
                    </controls:SettingsCard>
                </StackPanel>
            </ScrollViewer>

            <!-- footer -->
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Style="{StaticResource DxoCaption}" VerticalAlignment="Center" />
                <Button x:Name="UseButton" Grid.Column="1" Content="Use now" Click="Use_Click"
                        ToolTipService.ToolTip="Make this the active profile (also saves it)" />
                <Button x:Name="SaveButton" Grid.Column="2" Content="Save" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
            </Grid>
        </Grid>
    </Grid>
</Page>
