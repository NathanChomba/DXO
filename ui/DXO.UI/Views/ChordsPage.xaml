<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DXO.UI.Views.ChordsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource DxoPagePadding}" Spacing="8" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Chords" Style="{StaticResource DxoPageTitle}" />
            <TextBlock Style="{StaticResource DxoCaption}" TextWrapping="Wrap"
                       Text="Hold PS and press another button to do something on the PC without leaving your game. The game never sees the button. A quick PS tap on its own still works normally. Changes apply straight away, for every controller." />
            <InfoBar x:Name="OffInfo" IsOpen="False" IsClosable="False" Severity="Warning" Title="Chords are switched off"
                     Message="Turn on &quot;Controller shortcuts (chords)&quot; in Settings to use them." />

            <TextBlock Text="PS + button" Style="{StaticResource DxoSectionTitle}" />
            <Border Style="{StaticResource DxoCard}">
                <StackPanel x:Name="ChordRows" Spacing="6" />
            </Border>
            <Button Content="Restore DXO's chords" Click="ResetChords_Click" />

            <TextBlock Text="Quick menu" Style="{StaticResource DxoSectionTitle}" />
            <TextBlock Style="{StaticResource DxoCaption}" TextWrapping="Wrap"
                       Text="A ring of actions in the middle of the screen, opened by the chord set to &quot;Quick menu&quot; (PS + R3 unless you change it). Point at an item with a stick and let go, or press Cross. The first item sits at the top and the rest go round clockwise. Up to 12 items." />
            <Border Style="{StaticResource DxoCard}">
                <StackPanel x:Name="MenuRows" Spacing="6" />
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Add an item" Click="AddItem_Click" />
                <Button Content="Restore DXO's menu" Click="ResetMenu_Click" />
                <Button Content="Show the menu" Click="TryMenu_Click" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Style="{StaticResource DxoCaption}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
