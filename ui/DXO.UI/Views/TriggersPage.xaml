<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DXO.UI.Views.TriggersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="{StaticResource DxoPagePadding}" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="4" Padding="0,0,12,0">
                <TextBlock x:Name="PageTitle" Text="Adaptive Triggers" Style="{StaticResource DxoPageTitle}" />
                <TextBlock x:Name="SubTitle" Style="{StaticResource DxoCaption}" Margin="0,0,0,8" TextWrapping="Wrap"
                           Text="Give L2 and R2 a feel: pick a ready-made effect, then fine-tune it. Saved with the profile, so each game can have its own." />

                <InfoBar IsOpen="{x:Bind NotDualSense, Mode=OneWay}" IsClosable="False" Severity="Informational"
                         Title="Needs a DualSense"
                         Message="Adaptive triggers are a DualSense and DualSense Edge feature. Your settings are kept in the profile and apply when one is connected." />

                <!-- Two columns: Left trigger | Right trigger -->
                <Grid ColumnSpacing="16" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                <Border Style="{StaticResource DxoCard}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Left trigger (L2)" FontSize="16" FontWeight="SemiBold" />
                        <ComboBox x:Name="LeftEffect" Header="Effect" HorizontalAlignment="Stretch" DisplayMemberPath="Label" SelectionChanged="EffectChanged" />
                        <TextBlock x:Name="LeftAbout" Style="{StaticResource DxoCaption}" TextWrapping="Wrap" />
                        <Slider x:Name="LeftStart" Header="Starts at" Minimum="0" Maximum="9" StepFrequency="1" TickFrequency="1" TickPlacement="BottomRight" ValueChanged="SliderChanged" />
                        <Slider x:Name="LeftEnd" Header="Ends at" Minimum="1" Maximum="9" StepFrequency="1" TickFrequency="1" TickPlacement="BottomRight" ValueChanged="SliderChanged" />
                        <Slider x:Name="LeftStrength" Header="Strength" Minimum="1" Maximum="8" StepFrequency="1" TickFrequency="1" TickPlacement="BottomRight" ValueChanged="SliderChanged" />
                        <Slider x:Name="LeftSnap" Header="Snap" Minimum="1" Maximum="8" StepFrequency="1" TickFrequency="1" TickPlacement="BottomRight" ValueChanged="SliderChanged" />
                        <Slider x:Name="LeftFrequency" Header="Speed (per second)" Minimum="1" Maximum="60" StepFrequency="1" ValueChanged="SliderChanged" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource DxoCard}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Right trigger (R2)" FontSize="16" FontWeight="SemiBold" />
                        <ComboBox x:Name="RightEffect" Header="Effect" HorizontalAlignment="Stretch" DisplayMemberPath="Label" SelectionChanged="EffectChanged" />
                        <TextBlock x:Name="RightAbout" Style="{StaticResource DxoCaption}" TextWrapping="Wrap" />
                        <Slider x:Name="RightStart" Header="Starts at" Minimum="0" Maximum="9" StepFrequency="1" TickFrequency="1" TickPlacement="BottomRight" ValueChanged="SliderChanged" />
                        <Slider x:Name="RightEnd" Header="Ends at" Minimum="1" Maximum="9" StepFrequency="1" TickFrequency="1" TickPlacement="BottomRight" ValueChanged="SliderChanged" />
                        <Slider x:Name="RightStrength" Header="Strength" Minimum="1" Maximum="8" StepFrequency="1" TickFrequency="1" TickPlacement="BottomRight" ValueChanged="SliderChanged" />
                        <Slider x:Name="RightSnap" Header="Snap" Minimum="1" Maximum="8" StepFrequency="1" TickFrequency="1" TickPlacement="BottomRight" ValueChanged="SliderChanged" />
                        <Slider x:Name="RightFrequency" Header="Speed (per second)" Minimum="1" Maximum="60" StepFrequency="1" ValueChanged="SliderChanged" />
                    </StackPanel>
                </Border>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                    <Button Content="Copy left to right" Click="CopyLeft_Click" />
                    <Button Content="Both off" Click="BothOff_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SaveStatus" Style="{StaticResource DxoCaption}" VerticalAlignment="Center" />
            <Button x:Name="SaveButton" Grid.Column="1" Content="Save to profile" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
        </Grid>
    </Grid>
</Page>
