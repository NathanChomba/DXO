<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DXO.UI.Views.HapticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <Grid Padding="{StaticResource DxoPagePadding}" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Haptics and Rumble" Style="{StaticResource DxoPageTitle}" />
            <TextBlock x:Name="SubTitle" Style="{StaticResource DxoCaption}"
                       Text="Vibration from games, and sound through the controller. Changes apply straight away; Save keeps them in the profile." />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <Grid ColumnSpacing="16" Padding="0,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!-- ===== Left: rumble ===== -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Game vibration" Style="{StaticResource DxoSectionTitle}" Margin="0,0,0,6" />
                    <controls:SettingsCard Header="Rumble passthrough" Description="Play the vibration games send on your controller (Xbox 360 mode).">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE995;" /></controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="PassToggle" Toggled="Toggle_Changed" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Strength" Description="100% is what the game asks for. Above 100% boosts weak rumble.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9E9;" /></controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Slider x:Name="StrengthSlider" Width="180" Minimum="0" Maximum="200" StepFrequency="5" ValueChanged="Slider_Changed" />
                            <TextBlock x:Name="StrengthText" Width="44" VerticalAlignment="Center" Style="{StaticResource DxoMono}" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Swap motors" Description="Heavy rumble on the right, light on the left.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8AB;" /></controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="SwapToggle" Toggled="Toggle_Changed" />
                    </controls:SettingsCard>

                    <TextBlock Text="Test" Style="{StaticResource DxoSectionTitle}" Margin="0,12,0,6" />
                    <Border Style="{StaticResource DxoCard}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource DxoCaption}" Text="Each button buzzes for a second, so you can feel each motor." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="TestHeavy" Content="Heavy (left)" Click="TestHeavy_Click" />
                                <Button x:Name="TestLight" Content="Light (right)" Click="TestLight_Click" />
                                <Button x:Name="TestBoth" Content="Both" Click="TestBoth_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Right: audio ===== -->
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Controller speaker and headset" Style="{StaticResource DxoSectionTitle}" Margin="0,0,0,6" />
                    <controls:SettingsCard Header="Sound through the controller"
                                           Description="Turns on the controller's speaker and headset jack, and sets their volume.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE767;" /></controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="AudioToggle" Toggled="Toggle_Changed" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Volume">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE994;" /></controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Slider x:Name="VolumeSlider" Width="180" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="Slider_Changed" />
                            <TextBlock x:Name="VolumeText" Width="44" VerticalAlignment="Center" Style="{StaticResource DxoMono}" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Choose where sound plays" IsClickEnabled="True" Click="SoundSettings_Click"
                                           Description="Pick &quot;Wireless Controller&quot; as the output in Windows, or for one app under App volume.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7F3;" /></controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>
                    <InfoBar x:Name="AudioInfo" IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,4,0,0"
                             Message="Works over USB only. Over Bluetooth the controller needs a special audio format that DXO can't send yet." />

                    <TextBlock Text="DualSense haptics" Style="{StaticResource DxoSectionTitle}" Margin="0,12,0,6" />
                    <Border Style="{StaticResource DxoCard}">
                        <TextBlock Style="{StaticResource DxoCaption}" TextWrapping="Wrap"
                                   Text="Turning game audio into DualSense voice-coil haptics (like PS5 games feel) is planned. Games with native DualSense support already do this over USB when DXO is in Native mode." />
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SaveStatus" Style="{StaticResource DxoCaption}" VerticalAlignment="Center" />
            <Button x:Name="SaveButton" Grid.Column="1" Content="Save to profile" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
        </Grid>
    </Grid>
</Page>
