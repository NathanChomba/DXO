<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DXO.UI.Views.CommunityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="{StaticResource DxoPagePadding}" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Community" Style="{StaticResource DxoPageTitle}" />
            <TextBlock Style="{StaticResource DxoCaption}" TextWrapping="Wrap"
                       Text="Profiles other players have shared, grouped by game. Pick the setup that suits how you play. DXO only downloads from the hub; nothing is uploaded, and buttons set to open programs are removed." />
            <InfoBar x:Name="Result" IsOpen="False" IsClosable="True" Margin="0,8,0,0" />
        </StackPanel>

        <!-- shown until a hub address is set -->
        <Border x:Name="SetupCard" Grid.Row="1" Style="{StaticResource DxoCard}" Padding="16" Visibility="Collapsed">
            <StackPanel Spacing="10" MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock Text="Connect a profile hub" Style="{StaticResource DxoSectionTitle}" />
                <TextBlock TextWrapping="Wrap" Style="{StaticResource DxoCaption}"
                           Text="A hub is a public GitHub repository with an index.json listing its profiles. Paste the raw address of that index.json. DXO contacts it only while this page is open." />
                <TextBox x:Name="SetupBox" PlaceholderText="https://raw.githubusercontent.com/owner/dxo-profiles/main/index.json" />
                <Button Content="Connect" Style="{StaticResource AccentButtonStyle}" Click="Connect_Click" />
            </StackPanel>
        </Border>

        <!-- toolbar -->
        <Grid x:Name="Toolbar" Grid.Row="2" ColumnSpacing="8" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search games, profiles, authors, tags" QueryIcon="Find"
                            TextChanged="Search_TextChanged" MaxWidth="360" HorizontalAlignment="Stretch" />
            <ComboBox x:Name="CategoryBox" Grid.Column="1" MinWidth="170" SelectionChanged="Filter_Changed"
                      ToolTipService.ToolTip="Kind of game" />
            <ComboBox x:Name="ControllerBox" Grid.Column="2" MinWidth="150" SelectionChanged="Filter_Changed"
                      ToolTipService.ToolTip="Made for this controller" />
            <CheckBox x:Name="MineBox" Grid.Column="3" Content="Games on this PC" Click="Filter_Click" MinWidth="0" />
            <Button Grid.Column="4" Click="Refresh_Click" ToolTipService.ToolTip="Download the list again">
                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock Text="Refresh" /></StackPanel>
            </Button>
            <Button Grid.Column="5" ToolTipService.ToolTip="Hub address">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
                <Button.Flyout>
                    <Flyout x:Name="HubFlyout" Opening="HubFlyout_Opening">
                        <StackPanel Spacing="10" Width="380">
                            <TextBlock Text="Hub address (index.json)" Style="{StaticResource DxoCaption}" />
                            <TextBox x:Name="HubBox" PlaceholderText="https://.../index.json" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="Disconnect" Click="Disconnect_Click" />
                                <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Click="SaveHub_Click" />
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource DxoCaption}"
                                       Text="To share a profile: Profiles > Library > ... > Export this profile, then add the file to the hub repository with a pull request." />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- games and their setups -->
        <Grid Grid.Row="3">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="GroupList" Margin="0,0,12,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DxoCard}" Padding="16,12" Margin="0,0,0,10">
                                <StackPanel Spacing="4">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding Game}" Style="{StaticResource DxoSectionTitle}" VerticalAlignment="Center" />
                                            <Border Style="{StaticResource DxoPill}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" FontSize="12" />
                                            </Border>
                                            <Border Style="{StaticResource DxoPill}" VerticalAlignment="Center" Visibility="{Binding OwnedVisibility}">
                                                <TextBlock Text="On this PC" FontSize="12" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding CountText}" Style="{StaticResource DxoCaption}" VerticalAlignment="Center" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Profiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="0,10,0,4" ColumnSpacing="12" BorderThickness="0,1,0,0"
                                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Meta}" Style="{StaticResource DxoCaption}" />
                                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding TagText}" Visibility="{Binding TagVisibility}" FontSize="12"
                                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="{Binding ButtonText}" IsEnabled="{Binding CanGet}"
                                                            Click="Get_Click" MinWidth="100" VerticalAlignment="Center"
                                                            Style="{StaticResource AccentButtonStyle}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Visibility="Collapsed">
                <ProgressRing x:Name="Busy" IsActive="False" Width="32" Height="32" />
                <TextBlock x:Name="EmptyText" Style="{StaticResource DxoCaption}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
