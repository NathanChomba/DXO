<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DXO.UI.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource DxoPagePadding}" Spacing="8" MaxWidth="1200">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Diagnostics" Style="{StaticResource DxoPageTitle}" />
                    <TextBlock Text="How steadily your controller's reports reach DXO, and the raw bytes of the latest one."
                               Style="{StaticResource DxoCaption}" />
                </StackPanel>
                <ToggleButton x:Name="PauseButton" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE769;" FontSize="14" />
                        <TextBlock Text="Pause" />
                    </StackPanel>
                </ToggleButton>
            </Grid>

            <!-- stats -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource DxoCard}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Report rate" Style="{StaticResource DxoCaption}" />
                        <TextBlock x:Name="RateText" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource DxoCard}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Average gap" Style="{StaticResource DxoCaption}" />
                        <TextBlock x:Name="AvgText" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource DxoCard}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Jitter" Style="{StaticResource DxoCaption}" />
                        <TextBlock x:Name="JitterText" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource DxoCard}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Shortest / longest" Style="{StaticResource DxoCaption}" />
                        <TextBlock x:Name="RangeText" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource DxoCard}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Late reports" Style="{StaticResource DxoCaption}" />
                        <TextBlock x:Name="LateText" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- graph -->
            <TextBlock Text="Time between reports" Style="{StaticResource DxoSectionTitle}" Margin="0,8,0,0" />
            <Border Style="{StaticResource DxoCard}" Padding="12">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="200" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="GraphHost" SizeChanged="GraphHost_SizeChanged">
                        <Canvas x:Name="Graph">
                            <Line x:Name="AvgLine" Stroke="{StaticResource DxoTextSecondary}" StrokeThickness="1" StrokeDashArray="4,4" />
                            <Polyline x:Name="Trace" Stroke="{StaticResource DxoAccent}" StrokeThickness="1.5" />
                        </Canvas>
                        <TextBlock x:Name="ScaleTop" Style="{StaticResource DxoCaption}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <TextBlock x:Name="AvgLabel" Style="{StaticResource DxoCaption}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                    </Grid>
                    <TextBlock Grid.Row="1" x:Name="GraphNote" Style="{StaticResource DxoCaption}" TextWrapping="Wrap"
                               Text="Last 500 reports, newest on the right. A flat line is good; spikes are reports that arrived late (common over Bluetooth with Wi-Fi nearby)." />
                </Grid>
            </Border>

            <!-- raw report -->
            <TextBlock Text="Latest report" Style="{StaticResource DxoSectionTitle}" Margin="0,8,0,0" />
            <Border Style="{StaticResource DxoCard}" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="ReportHeader" Style="{StaticResource DxoCaption}" />
                    <TextBlock x:Name="HexDump" FontFamily="Consolas" FontSize="13" IsTextSelectionEnabled="True" />
                    <TextBlock Style="{StaticResource DxoCaption}" TextWrapping="Wrap"
                               Text="Bytes that just changed are highlighted: press a button or move a stick to see which bytes carry it." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
