<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DXO.UI.Views.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Pages that arrive in later milestones. MainWindow passes a PlaceholderInfo. -->
    <StackPanel Padding="{StaticResource DxoPagePadding}" Spacing="4" MaxWidth="1200" HorizontalAlignment="Left">
        <TextBlock x:Name="TitleText" Style="{StaticResource DxoPageTitle}" />
        <Border Style="{StaticResource DxoCard}" Margin="0,12,0,0" MaxWidth="640" HorizontalAlignment="Left">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE823;" Foreground="{StaticResource DxoAccent}" />
                    <TextBlock x:Name="WhenText" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock x:Name="WhatText" Style="{StaticResource DxoCaption}" />
                <TextBlock Text="See ROADMAP.md for what's in each milestone." Style="{StaticResource DxoCaption}" />
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
