<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DXO.UI.Views.LightingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="{StaticResource DxoPagePadding}" Spacing="4">
            <TextBlock Text="Lighting" Style="{StaticResource DxoPageTitle}" />
            <TextBlock x:Name="SubTitle" Text="The light bar's colour and effect, saved with the profile. A controller shows this colour when its card (click its pill above) is set to &quot;Profile's colour&quot;; otherwise it keeps its player colour or its own. The effect applies either way." Style="{StaticResource DxoCaption}" TextWrapping="Wrap" Margin="0,0,0,8" />

            <SelectorBar x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
                <SelectorBarItem Text="Light bar" IsSelected="True" />
                <SelectorBarItem Text="Player LEDs" />
            </SelectorBar>

            <!-- ===== Light bar tab: modes left, colour right ===== -->
            <Grid x:Name="LightBarTab" ColumnSpacing="16" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="300" />
                    <ColumnDefinition Width="1.3*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <controls:SettingsCard Header="Brightness" Description="How bright the light bar is.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE706;" /></controls:SettingsCard.HeaderIcon>
                        <Slider x:Name="Brightness" Width="160" Minimum="5" Maximum="100" Value="100" StepFrequency="5" ValueChanged="Slider_Changed" />
                    </controls:SettingsCard>

                    <TextBlock Text="Effect" Style="{StaticResource DxoSectionTitle}" />
                    <RadioButtons x:Name="LightMode" SelectedIndex="0" SelectionChanged="Mode_Changed">
                        <RadioButton Content="Steady" />
                        <RadioButton Content="Breathing: fades up and down" />
                        <RadioButton Content="Pulse: a short blink" />
                        <RadioButton Content="Rainbow: cycles the colours" />
                        <RadioButton Content="Battery level: green when full, red when low" />
                    </RadioButtons>
                    <controls:SettingsCard x:Name="SpeedCard" Header="Speed">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEC4A;" /></controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Slider x:Name="SpeedSlider" Width="160" Minimum="1" Maximum="12" StepFrequency="0.5" ValueChanged="Slider_Changed" />
                            <TextBlock x:Name="SpeedText" Width="70" VerticalAlignment="Center" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Flash with rumble" Description="The light bar flares towards white while the controller vibrates.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE945;" /></controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="FlashToggle" Toggled="Toggle_Changed" />
                    </controls:SettingsCard>
                    <TextBlock x:Name="ModeHint" Style="{StaticResource DxoCaption}" TextWrapping="Wrap" Margin="4,4,0,0" />
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource DxoCard}">
                    <StackPanel Spacing="12">
                        <ColorPicker x:Name="Picker" ColorSpectrumShape="Ring"
                                     IsAlphaEnabled="False" IsMoreButtonVisible="False"
                                     IsColorPreviewVisible="True" IsHexInputVisible="True"
                                     Color="#B26BFF" ColorChanged="Picker_ColorChanged" />
                        <TextBlock Text="Swatches" Style="{StaticResource DxoCaption}" />
                        <ItemsControl x:Name="Swatches">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="28" Height="28" Padding="0" CornerRadius="14" Background="{Binding}" Click="Swatch_Click" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Player LEDs tab ===== -->
            <StackPanel x:Name="PlayerTab" Visibility="Collapsed" Spacing="4" Margin="0,8,0,0">
                <InfoBar IsOpen="{x:Bind NotDualSense, Mode=OneWay}" IsClosable="False" Severity="Informational"
                         Title="Needs a DualSense" Message="The DualShock 4 has no player LEDs; its light bar colour is the player indicator." />
                <RadioButtons x:Name="PlayerLeds" SelectedIndex="1" SelectionChanged="PlayerLeds_SelectionChanged"
                              IsEnabled="{x:Bind Device.IsDualSense, Mode=OneWay}">
                    <RadioButton Content="Off            ○ ○ ○ ○ ○" />
                    <RadioButton Content="Player one     ○ ○ ● ○ ○" />
                    <RadioButton Content="Player two     ○ ● ○ ● ○" />
                    <RadioButton Content="Player three   ● ○ ● ○ ●" />
                    <RadioButton Content="Player four    ● ● ○ ● ●" />
                    <RadioButton Content="All on         ● ● ● ● ●" />
                </RadioButtons>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
                <Button x:Name="SaveButton" Content="Save to profile" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
                <Button Content="Stop LED preview" Click="Reset_Click" ToolTipService.ToolTip="Player LEDs are a live preview; this goes back to what the profile shows" />
                <TextBlock x:Name="SaveStatus" Style="{StaticResource DxoCaption}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
