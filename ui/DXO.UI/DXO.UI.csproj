<Project Sdk="Microsoft.NET.Sdk">

  <!-- M4: WinUI 3 front end. Unpackaged (no MSIX) so the Rust DLL can simply
       sit next to the exe. Build the Rust side first: scripts\build.ps1 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DXO.UI</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Use the MSIX/PRI build tools shipped in NuGet instead of looking for
         Visual Studio's copy, so plain `dotnet build` works without VS. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\dxo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.*" />
    <!-- SettingsCard / SettingsExpander: the icon + title + description + control rows -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.*" />
  </ItemGroup>

  <!-- Copy the Rust engine next to the exe. Path matches `a release cargo build`. -->
  <ItemGroup>
    <None Include="..\..\target\release\dxo_core.dll" Condition="Exists('..\..\target\release\dxo_core.dll')">
      <Link>dxo_core.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Controller skins: line-art PNG + optional JSON hit-zones, copied to Skins\ -->
    <None Include="Assets\Skins\*.png;Assets\Skins\*.json">
      <Link>Skins\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Assets\dxo.ico;Assets\dxo-logo.png">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\profiles\*.toml">
      <Link>profiles\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
